# force ssl
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Remove index.html from URLs (canonical enforcement)
RewriteCond %{THE_REQUEST} ^GET\ .*/index\.html\ HTTP
RewriteRule ^(.*)index\.html$ /$1 [R=301,L]

# Language redirect for root index.html (the answer depends on Accept-Language: see Vary below)
RewriteCond %{HTTP_USER_AGENT} !(bot|crawler|spider|googlebot|bingbot|duckduckbot|baiduspider|yandex|sogou|exabot|slurp|facebot|ia_archiver) [NC]
RewriteCond %{REQUEST_URI} ^/index\.html$ [OR]
RewriteCond %{REQUEST_URI} ^/$
RewriteCond %{HTTP:Accept-Language} ^en [NC]
RewriteRule ^(index\.html)?$ /en/ [R=302,L,E=LANG_REDIRECT:1]

RewriteCond %{HTTP_USER_AGENT} !(bot|crawler|spider|googlebot|bingbot|duckduckbot|baiduspider|yandex|sogou|exabot|slurp|facebot|ia_archiver) [NC]
RewriteCond %{REQUEST_URI} ^/index\.html$ [OR]
RewriteCond %{REQUEST_URI} ^/$
RewriteRule ^(index\.html)?$ /pl/ [R=302,L,E=LANG_REDIRECT:1]

# A page that does not exist (public/404.html: noindex, links to both languages)
ErrorDocument 404 /404.html

# Compression of text files
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml application/manifest+json image/svg+xml
</IfModule>

# Headers (need mod_headers). Not set: a Content-Security-Policy, because the pages carry
# inline scripts of their own (see tools/postbuild.cjs) and load Google Analytics and YouTube
# only after consent; a policy loose enough for that would add little.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"

    # The redirect from the root depends on the visitor's language: caches must not mix it up
    Header always append Vary "Accept-Language" env=LANG_REDIRECT
    Header always append Vary "Accept-Language" env=REDIRECT_LANG_REDIRECT
</IfModule>

# Caching (need mod_expires). The stylesheets and the script carry ?v=<build> in their URLs and
# the bundled fonts and scripts in /_astro/ have hashed names, so they can be kept for a year.
# Pictures keep their names when replaced, so a month; pages are always checked again.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
    ExpiresByType image/vnd.microsoft.icon "access plus 1 month"
    ExpiresByType application/manifest+json "access plus 1 week"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/xml "access plus 1 day"
    ExpiresByType text/xml "access plus 1 day"
</IfModule>
