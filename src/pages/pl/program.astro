---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProgramSchedule from '../../components/ProgramSchedule.astro';
import { edition } from '../../data/edition';
import { venues } from '../../data/program';

---
<BaseLayout
  title={`Program · MASSKA ${edition.year}`}
  description={`Program ${edition.numeral} Jubileuszowego Międzynarodowego Przeglądu Teatralnego MASSKA ${edition.year}: spektakle, film, koncerty i gala, dzień po dniu. ${edition.dateLabel.pl}, Sopot.`}
  lang="pl"
  redirectToPreferredLanguage={true}
>
<section class="hero">
            <div class="hero-text">
                <p class="eyebrow">{edition.numeral} Jubileuszowy Międzynarodowy Przegląd Teatralny</p>
                <h1>Program festiwalu MASSKA {edition.year}</h1>
                <p>{edition.dateLabel.pl} w Sopocie: spektakle teatrów z Polski i z zagranicy, film, koncerty i gala. Poniżej cały program, dzień po dniu.</p>
                <div class="hero-actions" data-online>
                    <a class="button primary" href="online.html">Oglądaj transmisje</a>
                </div>
                <div class="chip-row" role="list">
                    {edition.places.map((place) => <span class="chip" role="listitem">{place.when.pl} · {place.venue.shortName}</span>)}
                    <span class="chip" role="listitem">Spektakle, film i koncerty</span>
                    <span class="chip" role="listitem">Na żywo i online</span>
                </div>
            </div>
            <figure class="hero-media">
                <img src="../assets/img/plakaty/2026.webp" alt="Plakat XXV Jubileuszowego Przeglądu Teatralnego MASSKA 2026" width="900" height="1277" decoding="async"
                    fetchpriority="high">
            </figure>
        </section>

        <section class="page-section alt" aria-labelledby="lokalizacje">
            <div class="section-inner">
                <h2 id="lokalizacje">Miejsca festiwalu</h2>
                <div class="card-grid">
                    {edition.places.map((place) => (
                        <article class="card">
                            <h3>{place.venue.name}</h3>
                            <p><strong>{place.when.pl}</strong> · {place.venue.street}, {place.venue.city}</p>
                        </article>
                    ))}
                    <article class="card">
                        <h3>{venues.mamuszki14.name}</h3>
                        <p><strong>16.11</strong> · {venues.mamuszki14.city}. Gala i zabawa dla uczestników przeglądu.</p>
                    </article>
                </div>
            </div>
        </section>

        <section class="page-section" aria-labelledby="program-szczegolowy">
            <div class="section-inner">
                <h2 id="program-szczegolowy">Program szczegółowy</h2>

                <ProgramSchedule lang="pl" />

                <div class="announcement">
                    <p><strong>Uwaga:</strong> Organizator zastrzega sobie prawo do zmian w programie z powodów od niego
                        niezależnych.</p>
                </div>
            </div>
        </section>

        <section class="page-section alt" aria-labelledby="informacje-praktyczne">
            <div class="section-inner two-column">
                <div>
                    <h2 id="informacje-praktyczne">Informacje praktyczne</h2>
                    <p>Festiwal łączy dwie formy: spektakle na żywo w Sopocie ({edition.dateLabel.pl}) i MASSKA Online,
                        gdzie {edition.online.dateLabel.pl} można oglądać spektakle teatrów z całego świata.</p>

                </div>
                <aside class="info-panel" aria-label="Najważniejsze informacje praktyczne">
                    <h2>Kontakt organizacyjny</h2>
                    <dl>
                        <div>
                            <dt>Pytania</dt>
                            <dd><a href="kontakt.html">Formularz kontaktowy</a></dd>
                        </div>
                        <div>
                            <dt>Miejsce</dt>
                            <dd>{edition.places.map((place) => <div>{place.when.pl}: {place.venue.name}<br>{place.venue.street}, {place.venue.city}</div>)}<div>16.11 (gala): {venues.mamuszki14.name}, {venues.mamuszki14.city}</div></dd>
                        </div>
                    </dl>
                </aside>
            </div>
        </section>

</BaseLayout>
