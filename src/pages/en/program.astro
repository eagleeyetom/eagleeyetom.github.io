---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { edition } from '../../data/edition';

// PLACEHOLDER: the 2026 programme is not announced yet. Replace the days below
// (and the dates in src/data/edition.ts) once it is.
const days = [
  { title: 'Day 1', entries: ['Lorem ipsum (City): Dolor sit amet', 'Consectetur (City): Adipiscing elit'] },
  { title: 'Day 2', entries: ['Sed do eiusmod (City): Tempor incididunt', 'Ut labore (City): Et dolore magna', 'Aliqua (City): Ut enim ad minim'] },
  { title: 'Day 3', entries: ['Quis nostrud (City): Exercitation', 'Ullamco laboris (City): Nisi ut aliquip'] },
  { title: 'Day 4', entries: ['Ex ea commodo (City): Consequat', 'Duis aute (City): Irure dolor in reprehenderit'] },
  { title: 'Day 5', entries: ['Voluptate velit (City): Esse cillum dolore', 'Eu fugiat nulla (City): Pariatur excepteur'] },
];
---
<BaseLayout
  title={`Schedule · MASSKA ${edition.year}`}
  description={`Schedule of the ${edition.numeral} MASSKA Anniversary International Theatre Review ${edition.year}. Performances, workshops and events at Teatr Atelier in Sopot.`}
  lang="en"
  showPartners={true}
  redirectToPreferredLanguage={true}
>
<section class="hero">
            <div class="hero-text">
                <p class="eyebrow">{edition.numeral} Anniversary International Theatre Review</p>
                <h1>MASSKA {edition.year} Festival Program</h1>
                <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. {edition.dateLabel.en} in Sopot
                    — sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
                <div class="hero-actions">
                    <a class="button primary" href="online.html">Watch streams</a>
                    <a class="button secondary"
                        href="https://docs.google.com/forms/d/1-cCnZtjLfHMI9uyEodcN6xm2t2ZBQPrVYIwB4eLu0yE/viewform"
                        target="_blank" rel="noopener noreferrer">Theatre submission</a>
                </div>
                <div class="chip-row" role="list">
                    <span class="chip" role="listitem">{edition.venue.shortName}</span>
                    <span class="chip" role="listitem">Performances & workshops</span>
                    <span class="chip" role="listitem">Live and online</span>
                </div>
            </div>
            <figure class="hero-media">
                <img src="../assets/img/plakaty/2026.webp" alt="Poster of the XXV MASSKA Anniversary Theatre Review 2026" width="900" height="1277" decoding="async"
                    fetchpriority="high">
            </figure>
        </section>

        <section class="page-section alt" aria-labelledby="venues">
            <div class="section-inner">
                <h2 id="venues">Festival venue</h2>
                <div class="card-grid">
                    <article class="card">
                        <h3>{edition.venue.name}</h3>
                        <p>{edition.venue.street}, {edition.venue.city}. Lorem ipsum dolor sit amet, consectetur
                            adipiscing elit, sed do eiusmod tempor incididunt.</p>
                    </article>
                </div>
            </div>
        </section>

        <section class="page-section" aria-labelledby="detailed-program">
            <div class="section-inner">
                <h2 id="detailed-program">Detailed schedule</h2>

                <div class="announcement">
                    <p><strong>Programme in preparation.</strong> The entries below are placeholders: the full
                        programme will be published once the dates and ensembles are confirmed.</p>
                </div>

                <div class="timeline">
                    {days.map((day) => (
                        <div class="timeline-item">
                            <h3>{day.title} · XX November {edition.year}</h3>
                            <p><strong>{edition.venue.shortName}</strong></p>
                            <ul>
                                {day.entries.map((entry) => (
                                    <li><strong>00:00</strong> — {entry} (00 min)</li>
                                ))}
                            </ul>
                        </div>
                    ))}
                </div>

                <div class="announcement">
                    <p><strong>Notice:</strong> The organizer reserves the right to make changes to the program for
                        reasons beyond their control.</p>
                </div>
            </div>
        </section>

        <section class="page-section alt" aria-labelledby="practical-info">
            <div class="section-inner two-column">
                <div>
                    <h2 id="practical-info">Practical information</h2>
                    <p>The festival takes place in a hybrid format — performances are available live in Sopot and via
                        online streaming.</p>

                    <h3>Accessibility</h3>
                    <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut
                        labore et dolore magna aliqua.</p>

                    <h3>Workshop registration</h3>
                    <p>Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea
                        commodo consequat.</p>
                </div>
                <aside class="info-panel" aria-label="Key practical information">
                    <h2>Organizational contact</h2>
                    <dl>
                        <div>
                            <dt>Questions and inquiries</dt>
                            <dd><a href="contact.html">Contact form</a></dd>
                        </div>
                        <div>
                            <dt>Venue</dt>
                            <dd>{edition.venue.name}<br>{edition.venue.street}<br>{edition.venue.city}</dd>
                        </div>
                    </dl>
                </aside>
            </div>
        </section>

</BaseLayout>
