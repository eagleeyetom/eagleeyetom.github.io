---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProgramSchedule from '../../components/ProgramSchedule.astro';
import { edition } from '../../data/edition';
import { venues } from '../../data/program';

---
<BaseLayout
  title={`Schedule · MASSKA ${edition.year}`}
  description={`Schedule of the ${edition.numeral} MASSKA Anniversary International Theatre Review ${edition.year}: performances, a film, concerts and a gala, day by day. ${edition.dateLabel.en}, Sopot.`}
  lang="en"
  redirectToPreferredLanguage={true}
>
<section class="hero">
            <div class="hero-text">
                <p class="eyebrow">{edition.numeral} Anniversary International Theatre Review</p>
                <h1>MASSKA {edition.year} Festival Program</h1>
                <p>{edition.dateLabel.en} in Sopot: performances by theatres from Poland and abroad, a film, concerts and a gala. The whole programme is below, day by day.</p>
                <div class="hero-actions" data-online>
                    <a class="button primary" href="online.html">Watch streams</a>
                </div>
                <div class="chip-row" role="list">
                    {edition.places.map((place) => <span class="chip" role="listitem">{place.when.en} · {place.venue.shortName}</span>)}
                    <span class="chip" role="listitem">Performances, film & concerts</span>
                    <span class="chip" role="listitem">Live and online</span>
                </div>
            </div>
            <figure class="hero-media">
                <img src="../assets/img/plakaty/2026.webp" alt="Poster of the XXV MASSKA Anniversary Theatre Review 2026" width="900" height="1277" decoding="async"
                    fetchpriority="high">
            </figure>
        </section>

        <section class="page-section alt" aria-labelledby="venues">
            <div class="section-inner">
                <h2 id="venues">Festival venues</h2>
                <div class="card-grid">
                    {edition.places.map((place) => (
                        <article class="card">
                            <h3>{place.venue.name}</h3>
                            <p><strong>{place.when.en}</strong> · {place.venue.street}, {place.venue.city}</p>
                        </article>
                    ))}
                    <article class="card">
                        <h3>{venues.mamuszki14.name}</h3>
                        <p><strong>16 Nov</strong> · {venues.mamuszki14.city}. Gala and party for the participants of the review.</p>
                    </article>
                </div>
            </div>
        </section>

        <section class="page-section" aria-labelledby="detailed-program">
            <div class="section-inner">
                <h2 id="detailed-program">Detailed schedule</h2>

                <ProgramSchedule lang="en" />

                <div class="announcement">
                    <p><strong>Notice:</strong> The organizer reserves the right to make changes to the program for
                        reasons beyond their control.</p>
                </div>
            </div>
        </section>

        <section class="page-section alt" aria-labelledby="practical-info">
            <div class="section-inner two-column">
                <div>
                    <h2 id="practical-info">Practical information</h2>
                    <p>The festival has two parts: live performances in Sopot ({edition.dateLabel.en}) and MASSKA Online,
                        where performances by theatres from all over the world can be watched {edition.online.dateLabel.en}.</p>

                </div>
                <aside class="info-panel" aria-label="Key practical information">
                    <h2>Organizational contact</h2>
                    <dl>
                        <div>
                            <dt>Questions and inquiries</dt>
                            <dd><a href="contact.html">Contact form</a></dd>
                        </div>
                        <div>
                            <dt>Venue</dt>
                            <dd>{edition.places.map((place) => <div>{place.when.en}: {place.venue.name}<br>{place.venue.street}, {place.venue.city}</div>)}<div>16 Nov (gala): {venues.mamuszki14.name}, {venues.mamuszki14.city}</div></dd>
                        </div>
                    </dl>
                </aside>
            </div>
        </section>

</BaseLayout>
