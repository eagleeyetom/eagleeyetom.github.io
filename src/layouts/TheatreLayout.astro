---
import BaseLayout from './BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import WorldMap from '../components/WorldMap.astro';

interface Props {
  // Typed from the content schema so fields missing there fail `astro check`
  frontmatter: CollectionEntry<'theatres'>['data'];
  lang: 'pl' | 'en';
}

const { frontmatter, lang } = Astro.props;
const isPl = lang === 'pl';

// Quotes in content come with mixed or missing quote marks; the layout adds its own
const quoteText = frontmatter.quote?.trim().replace(/^["„“”]+|["„“”]+$/g, '').trim();

// Helper to convert absolute paths to relative paths based on language subfolder context
function getRelativeUrl(targetPath: string) {
  if (!targetPath) return '';
  if (targetPath.startsWith('http') || targetPath.startsWith('mailto:') || targetPath.startsWith('#')) {
    return targetPath;
  }
  
  let cleanPath = targetPath;
  if (cleanPath.startsWith('https://masska.org')) {
    cleanPath = cleanPath.substring(18);
  }
  
  if (cleanPath.startsWith('/pl/')) {
    const file = cleanPath.substring(4);
    return isPl ? file : `../pl/${file}`;
  }
  if (cleanPath.startsWith('/en/')) {
    const file = cleanPath.substring(4);
    return !isPl ? file : `../en/${file}`;
  }
  
  // Handle root asset links
  if (cleanPath.startsWith('/assets/')) {
    return `..${cleanPath}`;
  }
  
  return cleanPath;
}

// Find translation URL
const allTheatres = await getCollection('theatres');
const translationLang = isPl ? 'en' : 'pl';
const translationEntry = allTheatres.find(
  t => t.data.id === frontmatter.id && t.id.startsWith(`${translationLang}/`)
);

let translationUrl = undefined;
if (translationEntry) {
  const tSlug = translationEntry.slug.split('/').pop();
  translationUrl = translationLang === 'pl' ? `/pl/${tSlug}.html` : `/en/${tSlug}.html`;
}

// Ensembles for the accordion list
const listTheatres = allTheatres
  .filter(t => t.id.startsWith(`${lang}/`))
  .sort((a, b) => a.data.country.localeCompare(b.data.country, lang) || a.data.name.localeCompare(b.data.name, lang));

const position = listTheatres.findIndex((t) => t.data.id === frontmatter.id);
const previousTheatre = position > 0 ? listTheatres[position - 1] : undefined;
const nextTheatre = position >= 0 && position < listTheatres.length - 1 ? listTheatres[position + 1] : undefined;

// Ensembles with more than one show share a name; tell them apart by the show title
function theatreLabel(entry: CollectionEntry<'theatres'>) {
  const sameName = listTheatres.filter(t => t.data.name === entry.data.name).length > 1;
  return sameName ? `${entry.data.name} – ${entry.data.showTitle}` : entry.data.name;
}

function getTheatreUrl(entry: any) {
  const tLang = entry.id.startsWith('pl/') ? 'pl' : 'en';
  const tSlug = entry.slug.split('/').pop();
  return tLang === 'pl' ? `/pl/${tSlug}.html` : `/en/${tSlug}.html`;
}
---

<BaseLayout
  title={`${frontmatter.name} · ${frontmatter.showTitle} · MASSKA`}
  description={`${frontmatter.name} (${frontmatter.city}) · spektakl "${frontmatter.showTitle}" · ${frontmatter.genre}`}
  lang={lang}
  isTheatre={true}
  activeTheatreId={frontmatter.id}
  translationUrl={translationUrl}
  robots={frontmatter.placeholder ? 'noindex, follow' : undefined}
>
    {frontmatter.placeholder && (
        <div class="placeholder-note">
            <p>
                <strong>{isPl ? "Wpis zastępczy." : "Placeholder entry."}</strong>
                {isPl
                    ? " Ten zespół i opis są zaślepką: prawdziwe dane pojawią się po zatwierdzeniu programu."
                    : " This ensemble and its description are a stand-in: the real details will appear once the programme is confirmed."}
            </p>
        </div>
    )}

    <!-- Hero Section -->
    <section class="page-section theatre-hero">
        <div class="section-inner two-column">
            <div>
                <span class="badge">
                    {frontmatter.badgeText} <span class={`fi fi-${frontmatter.countryCode}`} aria-hidden="true"></span>
                </span>
                <h1>{frontmatter.name}</h1>
                <div set:html={frontmatter.synopsis} />
                <div class="hero-actions">
                    {frontmatter.recordingUrl && (
                        <a class="button primary" href={frontmatter.recordingUrl} target="_blank" rel="noopener">
                            {isPl ? "Odtwórz spektakl" : "Play video"}
                        </a>
                    )}
                    <a class="button secondary" href={getRelativeUrl(isPl ? "/pl/online.html" : "/en/online.html")}>
                        {isPl ? "Wróć do sceny online" : "Back to the online stage"}
                    </a>
                </div>
                <ul class="chip-row" role="list">
                    <li class="chip" role="listitem">{frontmatter.genre}</li>
                    <li class="chip" role="listitem">{frontmatter.duration}</li>
                    <li class="chip" role="listitem">{isPl ? `Napisy: ${frontmatter.subtitles}` : `Subtitles: ${frontmatter.subtitles}`}</li>
                </ul>
                <div class="theatre-hero__map">
                <WorldMap
                    lang={lang}
                    mode="single"
                    activeId={frontmatter.id}
                    pins={[{
                        id: frontmatter.id,
                        name: frontmatter.name,
                        city: frontmatter.city.split(',')[0],
                        country: frontmatter.country,
                        countryCode: frontmatter.countryCode,
                        lat: frontmatter.lat,
                        lon: frontmatter.lon,
                    }]}
                />
                </div>
            </div>
            <aside class="info-panel info-panel--facts" aria-label={isPl ? "Informacje o spektaklu" : "Performance details"}>
                <h2>{isPl ? "Przegląd spektaklu" : "Performance overview"}</h2>
                <dl>
                    <div>
                        <dt>{isPl ? "Tytuł" : "Title"}</dt>
                        <dd>{frontmatter.showTitle}</dd>
                    </div>
                    <div>
                        <dt>{isPl ? "Kraj" : "Country"}</dt>
                        <dd><span class={`fi fi-${frontmatter.countryCode}`} aria-hidden="true"></span> {frontmatter.country}</dd>
                    </div>
                    <div>
                        <dt>{isPl ? "Miasto" : "City"}</dt>
                        <dd>{frontmatter.city}</dd>
                    </div>
                    {frontmatter.language && (
                        <div>
                            <dt>{isPl ? "Język" : "Language"}</dt>
                            <dd>{frontmatter.language}</dd>
                        </div>
                    )}
                    {frontmatter.availability && (
                        <div>
                            <dt>{isPl ? "Dostępny online" : "Available online"}</dt>
                            <dd>{frontmatter.availability}</dd>
                        </div>
                    )}
                    {frontmatter.accessibility && (
                        <div>
                            <dt>{isPl ? "Dostępność" : "Accessibility"}</dt>
                            <dd>{frontmatter.accessibility}</dd>
                        </div>
                    )}
                </dl>
            </aside>
        </div>
    </section>

    <!-- Detailed Synopsis Section -->
    <section class="page-section alt" aria-labelledby="synopsis-title">
        <div class="section-inner">
            <h2 id="synopsis-title">{isPl ? "O spektaklu" : "Synopsis"}</h2>
            <div set:html={frontmatter.aboutShow} />
            {frontmatter.quote && (
                <blockquote class="pull-quote">{isPl ? "„" : "“"}{quoteText}”</blockquote>
            )}
        </div>
    </section>

    <!-- Video Section -->
    <section class="page-section" aria-label="Video">
        <div class="section-inner">
            {frontmatter.videoYtId ? (
                <div class="external-media" data-yt-id={frontmatter.videoYtId} data-title={frontmatter.videoTitle ?? frontmatter.showTitle}>
                </div>
            ) : (
                <div class="video-soon">
                    <p class="video-soon__title">{isPl ? "Nagranie pojawi się tutaj" : "The recording will appear here"}</p>
                    <p>
                        {frontmatter.availability
                            ? (isPl ? `Dostępne online: ${frontmatter.availability}` : `Available online: ${frontmatter.availability}`)
                            : (isPl ? "Spektakl będzie dostępny w czasie festiwalu." : "The performance will be available during the festival.")}
                    </p>
                </div>
            )}
        </div>
    </section>

    <!-- Gallery Section -->
    {frontmatter.gallery && frontmatter.gallery.length > 0 && (
        <section class="page-section" aria-label="Gallery">
            <div class="section-inner">
                <div class="theatre-gallery" aria-label={isPl ? "Karuzela zdjęć zespołu" : "Ensemble photo gallery"} role="region" data-gallery>
                    <div class="theatre-gallery__track" tabindex="0" role="group" aria-label={isPl ? "Zdjęcia, przewijaj w bok" : "Photos, scroll sideways"}>
                        {frontmatter.gallery.map(img => (
                            <figure>
                                <img src={getRelativeUrl(img.src)} width="800" height="560" loading="lazy" decoding="async" alt={img.alt} />
                                <figcaption>{img.alt}</figcaption>
                            </figure>
                        ))}
                    </div>
                    <div class="theatre-gallery__controls">
                        <button type="button" class="gallery-btn" data-gallery-prev aria-label={isPl ? "Poprzednie zdjęcie" : "Previous photo"}>‹</button>
                        <button type="button" class="gallery-btn" data-gallery-toggle data-icon-pause="❚❚" data-icon-play="▶" data-label-pause={isPl ? "Wstrzymaj automatyczne przewijanie" : "Pause autoplay"} data-label-play={isPl ? "Wznów automatyczne przewijanie" : "Resume autoplay"} aria-pressed="false">❚❚</button>
                        <button type="button" class="gallery-btn" data-gallery-next aria-label={isPl ? "Następne zdjęcie" : "Next photo"}>›</button>
                    </div>
                    <div class="theatre-gallery__dots" role="group" aria-label={isPl ? "Wybierz zdjęcie" : "Choose photo"}></div>
                </div>
            </div>
        </section>
    )}

    <!-- About Ensemble Section -->
    {(frontmatter.about || frontmatter.credits) && (
        <section class="page-section" aria-labelledby="ensemble-info-title">
            <div class="section-inner two-column">
                <div>
                    <h2 id="ensemble-info-title">{isPl ? "O zespole" : "About the ensemble"}</h2>
                    {frontmatter.about && <div set:html={frontmatter.about} />}
                </div>
                {frontmatter.credits && (
                    <aside class="info-panel" aria-label={frontmatter.credits.title}>
                        <h2>{frontmatter.credits.title}</h2>
                        <ul class="meta-list">
                            {frontmatter.credits.items.map(item => (
                                <li><strong>{item.label}:</strong> {item.value}</li>
                            ))}
                        </ul>
                    </aside>
                )}
            </div>
        </section>
    )}

    <!-- History & Contact Section -->
    {(frontmatter.history || frontmatter.contactEmail) && (
        <section class="page-section alt" aria-labelledby="ensemble-history-title">
            <div class="section-inner two-column">
                <div>
                    <h2 id="ensemble-history-title">{isPl ? "Historia zespołu" : "Ensemble history"}</h2>
                    {frontmatter.history ? <div set:html={frontmatter.history} /> : <p />}
                </div>
                {frontmatter.contactEmail && (
                    <aside class="info-panel" aria-label="Contact information">
                        <h2>{isPl ? "Kontakt" : "Contact"}</h2>
                        <ul class="contact-list">
                            {frontmatter.contactName && (
                                <li>{frontmatter.contactRole ? `${frontmatter.contactRole}: ` : ""}{frontmatter.contactName}</li>
                            )}
                            <li>Email: <a href={`mailto:${frontmatter.contactEmail}`}>{frontmatter.contactEmail}</a></li>
                            {frontmatter.contactSocialUrl && (
                                <li>Social media: <a href={frontmatter.contactSocialUrl} target="_blank" rel="noopener noreferrer">{frontmatter.contactSocialText || "Link"}</a></li>
                            )}
                        </ul>
                    </aside>
                )}
            </div>
        </section>
    )}

    <!-- Previous / next performance, in the order of the online stage -->
    {(previousTheatre || nextTheatre) && (
        <nav class="stage-pager" aria-label={isPl ? "Inne spektakle" : "More performances"}>
            {previousTheatre ? (
                <a class="stage-pager__link" href={getRelativeUrl(getTheatreUrl(previousTheatre))} rel="prev">
                    <span class="stage-pager__label">&larr; {isPl ? "Poprzedni spektakl" : "Previous performance"}</span>
                    <strong>{previousTheatre.data.showTitle}</strong>
                    <small><span class={`fi fi-${previousTheatre.data.countryCode}`} aria-hidden="true"></span> {previousTheatre.data.name}, {previousTheatre.data.country}</small>
                </a>
            ) : <span></span>}
            {nextTheatre ? (
                <a class="stage-pager__link stage-pager__link--next" href={getRelativeUrl(getTheatreUrl(nextTheatre))} rel="next">
                    <span class="stage-pager__label">{isPl ? "Następny spektakl" : "Next performance"} &rarr;</span>
                    <strong>{nextTheatre.data.showTitle}</strong>
                    <small><span class={`fi fi-${nextTheatre.data.countryCode}`} aria-hidden="true"></span> {nextTheatre.data.name}, {nextTheatre.data.country}</small>
                </a>
            ) : <span></span>}
        </nav>
    )}

    <!-- Accordion list of all theatres -->
    <section class="page-section" aria-labelledby="ensemble-list-title">
        <div class="section-inner">
            <h2 id="ensemble-list-title">{isPl ? "Zespoły festiwalowe" : "Festival ensembles"}</h2>
            <details class="info-panel">
                <summary>{isPl ? "Rozwiń listę zespołów" : "Expand ensemble list"}</summary>
                <ul class="meta-list">
                    {listTheatres.map(t => (
                        <li>
                            <a href={getRelativeUrl(getTheatreUrl(t))}>
                                {theatreLabel(t)} <span class={`fi fi-${t.data.countryCode}`} aria-hidden="true"></span>
                            </a>
                        </li>
                    ))}
                </ul>
            </details>
        </div>
    </section>
</BaseLayout>

<style>
    /* Hero: less air above and below, the facts in two columns, the map under the text */
    .theatre-hero {
        padding-block: clamp(2rem, 4vw, 3.5rem);
    }

    .theatre-hero .two-column {
        align-items: start;
    }

    .theatre-hero__map {
        max-width: 38rem;
    }

    .info-panel--facts dl {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
        gap: var(--spacing-sm) var(--spacing-md);
        margin: 0;
    }

    .info-panel--facts dl > div {
        min-width: 0;
    }

    .placeholder-note {
        padding: var(--spacing-sm) var(--gutter);
        background: var(--color-peach);
        color: var(--color-text);
        text-align: center;
    }

    .placeholder-note p {
        margin: 0;
        color: inherit;
    }

    .video-soon {
        display: grid;
        place-content: center;
        justify-items: center;
        gap: 0.35rem;
        min-height: 16rem;
        padding: var(--spacing-lg);
        border-radius: var(--radius-md);
        background: #1f1d1b;
        color: #f5f2ee;
        text-align: center;
    }

    .video-soon p {
        margin: 0;
        color: inherit;
    }

    .video-soon__title {
        font-family: var(--font-family-headers);
        font-size: clamp(1.4rem, 3vw, 2rem);
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    .stage-pager {
        display: grid;
        gap: var(--spacing-md);
        max-width: var(--max-width);
        margin: 0 auto;
        padding: var(--spacing-lg) var(--gutter);
    }

    @media (min-width: 720px) {
        .stage-pager {
            grid-template-columns: 1fr 1fr;
        }
    }

    .stage-pager__link {
        display: grid;
        gap: 0.2rem;
        padding: var(--spacing-md);
        border: 2px solid var(--color-text);
        border-radius: var(--radius-ui);
        color: var(--color-text);
        text-decoration: none;
        transition: background-color var(--transition-base), color var(--transition-base);
    }

    .stage-pager__link--next {
        text-align: right;
    }

    .stage-pager__link:hover,
    .stage-pager__link:focus-visible {
        background: var(--btn-hover);
        color: var(--btn-hover-fg);
        text-decoration: none;
    }

    .stage-pager__label {
        font-family: var(--font-family-headers);
        font-size: 0.85rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }

    .stage-pager__link strong {
        font-family: var(--font-family-headers);
        font-size: 1.4rem;
        font-weight: 600;
    }
</style>
