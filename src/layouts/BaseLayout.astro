---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { edition } from '../data/edition';
import { performanceEvents } from '../data/program';
import { assetVersion } from '../data/build';
// Self-hosted fonts (no request to Google Fonts): Oswald for headings, Inter for text
import '@fontsource-variable/oswald/wght.css';
import '@fontsource-variable/inter/wght.css';

interface Props {
  title: string;
  description: string;
  lang: 'pl' | 'en';
  robots?: string;
  isTheatre?: boolean;
  activeTheatreId?: string;
  translationUrl?: string;
  redirectToPreferredLanguage?: boolean;
}

const {
  title,
  description,
  lang,
  robots,
  isTheatre = false,
  activeTheatreId,
  translationUrl,
  redirectToPreferredLanguage = true,
} = Astro.props;

const siteUrl = 'https://masska.org';
// build.format 'file' renders /pl/index.astro as /pl.html; postbuild moves it to /pl/index.html
const pathname = Astro.url.pathname.replace(/^\/(pl|en)\.html$/, '/$1/');
const canonical = `${siteUrl}${pathname}`;

// Map current page to its translated counterpart
const staticMappings: Record<string, string> = {
  '/pl/': '/en/',
  '/pl/index.html': '/en/index.html',
  '/pl/program.html': '/en/program.html',
  '/pl/online.html': '/en/online.html',
  '/pl/kontakt.html': '/en/contact.html',
  '/pl/cookies.html': '/en/cookies.html',
  '/pl/dla-mediow.html': '/en/press.html',
  
  '/en/': '/pl/',
  '/en/index.html': '/pl/index.html',
  '/en/program.html': '/pl/program.html',
  '/en/online.html': '/pl/online.html',
  '/en/contact.html': '/pl/kontakt.html',
  '/en/cookies.html': '/pl/cookies.html',
  '/en/press.html': '/pl/dla-mediow.html',
};

let alternatePl = '/pl/';
let alternateEn = '/en/';

if (translationUrl) {
  if (lang === 'pl') {
    alternatePl = pathname;
    alternateEn = translationUrl;
  } else {
    alternatePl = translationUrl;
    alternateEn = pathname;
  }
} else {
  const mapped = staticMappings[pathname];
  if (mapped) {
    if (lang === 'pl') {
      alternatePl = pathname;
      alternateEn = mapped;
    } else {
      alternatePl = mapped;
      alternateEn = pathname;
    }
  }
}

const isPl = lang === 'pl';

// Structured data comes from the edition; the dates only go in once they are confirmed,
// so search engines never show a placeholder
const eventDates = edition.datesConfirmed
  ? { startDate: edition.start, endDate: edition.end }
  : {};
const place = (venue: (typeof edition.venues)[keyof typeof edition.venues]) => ({
  "@type": "Place",
  "name": venue.name,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": venue.street,
    "addressLocality": venue.city,
    "addressCountry": venue.country
  }
});
// Live in Sopot and online: with the mixed attendance mode search engines expect both kinds of place
const eventLocation = [
  ...Object.values(edition.venues).map(place),
  { "@type": "VirtualLocation", "url": `${siteUrl}${isPl ? '/pl/online.html' : '/en/online.html'}` }
];
const festivalName = isPl
  ? `${edition.numeral} Jubileuszowy Międzynarodowy Przegląd Teatralny MASSKA ${edition.year}`
  : `${edition.numeral} MASSKA Anniversary International Theatre Review ${edition.year}`;
const festivalUrl = `${siteUrl}${isPl ? '/pl/' : '/en/'}`;
// One entry per festival day (13 November, then 15-18 November), each at its own venue
const subEvents = edition.datesConfirmed
  ? edition.days.map((day, i) => ({
      "@type": "Event",
      "name": `${festivalName} · ${day.date}`,
      "startDate": edition.schedule[i].start,
      "endDate": edition.schedule[i].end,
      "eventStatus": "https://schema.org/EventScheduled",
      "eventAttendanceMode": "https://schema.org/MixedEventAttendanceMode",
      "location": place(day.venue)
    }))
  : [];
// The event markup describes the festival itself, so only the pages about the festival carry it
// (home pages and programme); an ensemble's page carries its own, the others none
const describesFestival = ['/pl/', '/en/', '/pl/program.html', '/en/program.html'].includes(pathname);
// The programme page lists every performance, so there the festival's parts are the performances themselves
const isProgramme = pathname === '/pl/program.html' || pathname === '/en/program.html';
const organizer = {
  "@type": "Organization",
  "name": "Stowarzyszenie Na Drodze Ekspresji",
  "url": "https://ekspresja.org"
};
// The root index.html is the language chooser, so it is the x-default for both home pages
const isHome = pathname === '/pl/' || pathname === '/en/';
---

<!DOCTYPE html>
<html lang={lang}>

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <!-- What search engines read comes first: title, description, robots; the scripts after it -->
    <meta name="description" content={description}>
    <!-- Allowed to show large pictures in search results and Discover, unless the page says otherwise -->
    <meta name="robots" content={robots ?? 'index, follow, max-image-preview:large'}>
    <title>{title}</title>
    <!-- Lets CSS enhance only what JS can operate (e.g. the shortened intro) -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <!-- The "watch online" buttons (marked data-online) only show once MASSKA Online has started, or in
         debug mode: open any page with ?debug (switch off with ?debug=0; remembered in this browser).
         Set before the first paint, so nothing flashes. Without JS the buttons stay hidden. -->
    <script is:inline define:vars={{ onlineFrom: edition.online.start }}>
        (function () {
            var root = document.documentElement;
            var debug = false;
            try {
                var param = new URLSearchParams(location.search).get('debug');
                var off = param === '0' || param === 'off';
                try {
                    if (off) localStorage.removeItem('masskaDebug');
                    else if (param !== null) localStorage.setItem('masskaDebug', '1');
                    debug = localStorage.getItem('masskaDebug') === '1';
                } catch (e) {}
                // the address alone is enough when the browser keeps no storage
                if (param !== null) debug = !off;
            } catch (e) {}
            if (debug) {
                root.classList.add('debug');
                // keep ?debug in the address while clicking through the site
                document.addEventListener('DOMContentLoaded', function () {
                    // the badge switches debug mode off again with one click
                    var pl = root.lang === 'pl';
                    var badge = document.createElement('button');
                    badge.type = 'button';
                    badge.className = 'debug-badge';
                    badge.textContent = 'DEBUG ✕';
                    badge.setAttribute('aria-label', pl ? 'Tryb debug włączony. Kliknij, aby wyłączyć' : 'Debug mode is on. Click to switch off');
                    badge.addEventListener('click', function () {
                        try { localStorage.removeItem('masskaDebug'); } catch (e) {}
                        var url = new URL(location.href);
                        url.searchParams.delete('debug');
                        if (url.href === location.href) location.reload();
                        else location.assign(url.href);
                    });
                    document.body.appendChild(badge);
                    document.querySelectorAll('a[href]').forEach(function (a) {
                        var href = a.getAttribute('href');
                        if (href.charAt(0) === '#' || a.hasAttribute('download')) return;
                        if (a.protocol !== location.protocol || a.host !== location.host) return;
                        if (!/(\.html|\/)$/.test(a.pathname)) return;
                        var url = new URL(a.href);
                        if (!url.searchParams.has('debug')) {
                            url.searchParams.set('debug', '1');
                            a.href = url.href;
                        }
                    });
                });
            }
            if (debug || Date.now() >= Date.parse(onlineFrom)) root.classList.add('online-live');
        })();
    </script>

    <!-- CSS Stylesheets -->
    <link rel="stylesheet" href={`../assets/styles.css?v=${assetVersion}`}>
    <link rel="stylesheet" href={`../assets/styles-mobile.css?v=${assetVersion}`}>

    <!-- Favicons -->
    <link rel="icon" href="../assets/icons/favicon.ico?v=20261102" sizes="any">
    <link rel="icon" type="image/png" sizes="16x16" href="../assets/icons/favicon-16x16.png?v=20261102">
    <link rel="icon" type="image/png" sizes="32x32" href="../assets/icons/favicon-32x32.png?v=20261102">
    <link rel="icon" type="image/png" sizes="192x192" href="../assets/icons/android-chrome-192x192.png?v=20261102">
    <link rel="apple-touch-icon" sizes="180x180" href="../assets/icons/apple-touch-icon.png?v=20261102">
    <link rel="manifest" href="../assets/icons/site.webmanifest?v=20261102">
    <meta name="theme-color" content="#111111">

    <!-- Canonical & hreflang alternates -->
    <link rel="canonical" href={canonical}>
    <link rel="alternate" href={`${siteUrl}${alternatePl}`} hreflang="pl">
    <link rel="alternate" href={`${siteUrl}${alternateEn}`} hreflang="en">
    <link rel="alternate" href={`${siteUrl}${isHome ? '/' : alternatePl}`} hreflang="x-default">

    <!-- Open Graph -->
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="MASSKA">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonical}>
    <meta property="og:image" content={`${siteUrl}/assets/img/og-masska-2026.jpg`}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content={isPl ? "XXV Jubileuszowy Międzynarodowy Przegląd Teatralny MASSKA 2026" : "XXV MASSKA Anniversary International Theatre Review 2026"}>
    <meta property="og:locale" content={isPl ? "pl_PL" : "en_US"}>
    <meta property="og:locale:alternate" content={isPl ? "en_US" : "pl_PL"}>

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={`${siteUrl}/assets/img/og-masska-2026.jpg`}>
    <!-- JSON-LD Structured Data -->
    {isTheatre ? (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "TheaterEvent",
        "name": title,
        "description": description,
        "url": canonical,
        "inLanguage": lang,
        ...eventDates,
        "eventStatus": "https://schema.org/EventScheduled",
        "eventAttendanceMode": "https://schema.org/MixedEventAttendanceMode",
        "location": eventLocation,
        "image": `${siteUrl}/assets/img/og-masska-2026.jpg`,
        "organizer": organizer,
        "superEvent": { "@type": "Festival", "name": festivalName, "url": festivalUrl }
      })} />
    ) : describesFestival ? (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Festival",
        "name": festivalName,
        "description": description,
        "url": canonical,
        "inLanguage": lang,
        ...eventDates,
        "eventStatus": "https://schema.org/EventScheduled",
        "eventAttendanceMode": "https://schema.org/MixedEventAttendanceMode",
        "location": eventLocation,
        "subEvent": isProgramme ? performanceEvents(lang) : subEvents,
        "image": `${siteUrl}/assets/img/og-masska-2026.jpg`,
        "organizer": organizer
      })} />
    ) : null}
</head>

<body data-redirect-to-preferred-language={redirectToPreferredLanguage ? "true" : "false"}>
    <a class="skip-link" href="#main-content">{isPl ? "Przejdź do treści" : "Skip to content"}</a>

    <!-- First in the tab order, so the consent choice is one Tab away; it is fixed to the bottom of the screen -->
    <CookieConsent lang={lang} />

    <Header 
      lang={lang} 
      isTheatre={isTheatre} 
      activeTheatreId={activeTheatreId} 
      translationUrl={isPl ? alternateEn : alternatePl}
    />

    <main id="main-content" class="page-content" role="main">
        <slot />
    </main>

    <Footer lang={lang} />



    <!-- Core App JS -->
    <script src={`../assets/app.js?v=${assetVersion}`} defer></script>
</body>

</html>
