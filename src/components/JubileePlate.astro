---
// The poster's title rebuilt from the cut-out lettering (public/assets/img/lettering,
// generated by tools/build_graphics.py). Purely visual: the page title lives in the
// visually hidden text of the <h1> that wraps it.
import { edition } from '../data/edition';

interface Props {
  /** Path from the current page to the site root: '../' for /pl and /en pages, '' for /. */
  base: string;
}

const { base } = Astro.props;
const dir = `${base}assets/img/lettering/`;
---

<div class="plate-wrap">
    <div class="plate" aria-hidden="true" data-confetti-origin>
        <img class="plate__title" src={`${dir}title.webp`} width="720" height="487" alt="" decoding="async" fetchpriority="high">
        <div class="plate__side">
            <img class="plate__masska" src={`${dir}masska.webp`} width="760" height="250" alt="" decoding="async" fetchpriority="high">
            <span class="plate__place">
                <span class="plate__city">{edition.city.pl}</span>
                <span class="plate__year">{edition.year}</span>
            </span>
        </div>
    </div>
</div>

<style>
    /* The two halves of the poster's head stand side by side when there is room, as on the
       poster, and one above the other in a narrow column */
    .plate-wrap {
        container-type: inline-size;
        width: 100%;
        max-width: 44rem;
    }

    .plate {
        display: grid;
        gap: 0.6rem 1.4rem;
        align-items: end;
    }

    @container (min-width: 30rem) {
        .plate {
            grid-template-columns: 1.08fr 1fr;
        }
    }

    .plate img {
        display: block;
        width: 100%;
        height: auto;
        border-radius: 0;
    }

    .plate__title {
        max-width: 26rem;
    }

    .plate__side {
        display: grid;
        gap: 0.2rem;
    }

    .plate__place {
        display: flex;
        align-items: baseline;
        justify-content: flex-end;
        gap: 0.35em;
        white-space: nowrap;
        font-family: var(--font-family-headers);
        font-weight: 700;
        line-height: 1;
        letter-spacing: 0.02em;
    }

    /* "Sopot 2026" scales with the plate (cqi), which may be a narrow column beside the figure:
       across its whole width one above the other, across the half of it side by side */
    .plate__city {
        font-size: min(9cqi, 3rem);
        color: var(--color-red-text);
    }

    .plate__year {
        font-size: min(11cqi, 3.8rem);
        letter-spacing: 0.08em;
        color: var(--color-grey-strong);
    }

    @container (min-width: 30rem) {
        .plate__city {
            font-size: min(6.8cqi, 3rem);
        }

        .plate__year {
            font-size: min(8.6cqi, 3.8rem);
        }
    }

    /* The lettering is stamped onto the page one piece after another, MASSKA last (once, on load).
       The pieces are there from the first paint, so nothing waits on the animation. */
    @media (prefers-reduced-motion: no-preference) {
        .plate__title,
        .plate__place {
            animation: plate-stamp 0.5s cubic-bezier(0.2, 1.3, 0.4, 1) var(--d, 0s) both;
        }

        .plate__title {
            --d: 0.05s;
        }

        .plate__place {
            --d: 0.3s;
        }

        .plate__masska {
            animation: plate-slam 0.65s cubic-bezier(0.2, 1.3, 0.4, 1) 0.45s both;
        }
    }

    @keyframes plate-stamp {
        from {
            opacity: 0;
            scale: 1.35;
            rotate: -4deg;
        }

        50% {
            opacity: 1;
        }

        to {
            opacity: 1;
            scale: 1;
            rotate: 0deg;
        }
    }

    @keyframes plate-slam {
        from {
            opacity: 0;
            scale: 1.7;
        }

        55% {
            opacity: 1;
            scale: 0.96;
        }

        78% {
            scale: 1.03;
        }

        to {
            opacity: 1;
            scale: 1;
        }
    }

    /* High contrast: the poster's red and black lettering turns white on the black page */
    :global(body.high-contrast) .plate img {
        filter: brightness(0) invert(1);
    }

    :global(body.high-contrast) .plate__city,
    :global(body.high-contrast) .plate__year {
        color: var(--color-text);
    }
</style>
