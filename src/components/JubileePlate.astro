---
// The poster's title band rebuilt from the cut-out lettering (public/assets/img/lettering,
// generated by tools/build_graphics.py). Purely visual: the page title lives in the
// visually hidden text of the <h1> that wraps it.
interface Props {
  /** Path from the current page to the site root: '../' for /pl and /en pages, '' for /. */
  base: string;
}

const { base } = Astro.props;
const dir = `${base}assets/img/lettering/`;
---

<div class="plate" aria-hidden="true">
    <div class="plate__top">
        <img class="plate__xxv" src={`${dir}xxv.webp`} width="420" height="251" alt="" decoding="async" fetchpriority="high">
        <div class="plate__stack">
            <img src={`${dir}jubileuszowy.webp`} width="640" height="146" alt="" decoding="async">
            <img src={`${dir}przeglad-teatralny.webp`} width="760" height="147" alt="" decoding="async">
        </div>
        <img class="plate__year" src={`${dir}2026.webp`} width="320" height="176" alt="" decoding="async">
    </div>
    <img class="plate__masska" src={`${dir}masska.webp`} width="1042" height="339" alt="" decoding="async" fetchpriority="high">
</div>

<style>
    .plate {
        display: grid;
        gap: clamp(0.5rem, 2vw, 1.1rem);
        width: 100%;
        max-width: 38rem;
        padding: clamp(0.9rem, 3vw, 1.6rem);
        border-radius: var(--radius-md);
        background: var(--color-mauve);
    }

    .plate img {
        display: block;
        width: 100%;
        height: auto;
        border-radius: 0;
    }

    .plate__top {
        display: grid;
        grid-template-columns: 27% minmax(0, 1fr) 22%;
        align-items: center;
        gap: clamp(0.4rem, 2vw, 1rem);
    }

    .plate__stack {
        display: grid;
        gap: clamp(0.15rem, 0.8vw, 0.45rem);
    }

    /* High contrast: the poster colours give way to black lettering on the yellow plate */
    :global(body.high-contrast) .plate img:not(.plate__year):not(.plate__masska) {
        filter: brightness(0);
    }
</style>
