---
interface Props {
  lang: 'pl' | 'en';
}

const { lang } = Astro.props;
const isPl = lang === 'pl';
---

<div class="cookie-notice" data-consent-banner role="dialog" aria-labelledby="cookie-title" hidden>
    <div class="cookie-notice__inner">
        <span class="cookie-notice__badge" aria-hidden="true">
            <img src="../assets/img/lettering/xxv.webp" width="420" height="251" alt="" loading="lazy" decoding="async" />
        </span>

        <div class="cookie-notice__content">
            <p class="cookie-notice__title" id="cookie-title">
                {isPl ? "25 lat Masski i Twoja prywatność" : "25 years of Masska and your privacy"}
            </p>
            {isPl ? (
                <p>Analityka (Google Analytics) i osadzone filmy z YouTube włączą się tylko za Twoją zgodą. Zobacz <a href="cookies.html">politykę cookies</a>.</p>
            ) : (
                <p>Analytics (Google Analytics) and embedded YouTube videos switch on only with your consent. See the <a href="cookies.html">cookie policy</a>.</p>
            )}
            <details class="cookie-notice__settings">
                <summary>{isPl ? "Ustawienia" : "Settings"}</summary>
                <fieldset>
                    <legend class="sr-only">{isPl ? "Preferencje zgód" : "Consent preferences"}</legend>
                    <label><input type="checkbox" data-consent-toggle="analytics"> {isPl ? "Analityka (Google Analytics)" : "Analytics (Google Analytics)"}</label>
                    <label><input type="checkbox" data-consent-toggle="media"> {isPl ? "Media (osadzenia YouTube)" : "Media (YouTube embeds)"}</label>
                </fieldset>
                <div class="cookie-notice__actions-row">
                    <button type="button" class="button secondary" data-consent-save>{isPl ? "Zapisz wybór" : "Save choices"}</button>
                </div>
            </details>
        </div>

        <div class="cookie-notice__actions">
            <button type="button" class="button primary" data-consent-accept-all>{isPl ? "Akceptuj wszystko" : "Accept all"}</button>
            <button type="button" class="button secondary" data-consent-reject>{isPl ? "Odrzuć zbędne" : "Reject non‑essential"}</button>
        </div>
    </div>
</div>
