---
import { edition, type Lang } from '../data/edition';
import JubileePlate from './JubileePlate.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const isPl = lang === 'pl';

const t = isPl
  ? {
      title: `${edition.numeral} Jubileuszowy Międzynarodowy Przegląd Teatralny MASSKA ${edition.year}`,
      lead: 'Od ćwierć wieku Masska zbiera na jednej scenie teatry z Polski i z zagranicy. Na jubileusz zapraszamy do Sopotu: na spektakle, warsztaty i spotkania z twórcami, na żywo i online.',
      when: 'Termin',
      where: 'Miejsce',
      provisional: 'termin do potwierdzenia',
      program: 'Zobacz program',
      online: 'Oglądaj online',
      countdownLabel: 'Do otwarcia festiwalu',
      countdownProvisional: 'Do terminu orientacyjnego',
      live: 'Festiwal trwa!',
      units: ['dni', 'godz.', 'min'],
      artAlt: 'Ilustracja z plakatu XXV edycji MASSKA: kora drzewa z dwoma otworami przypominającymi oczy, a pod nią kwiat słonecznika',
    }
  : {
      title: `${edition.numeral} MASSKA Anniversary International Theatre Review ${edition.year}`,
      lead: 'For a quarter of a century Masska has brought theatres from Poland and abroad onto one stage. For the anniversary we invite you to Sopot: performances, workshops and meetings with the artists, live and online.',
      when: 'Dates',
      where: 'Venue',
      provisional: 'dates to be confirmed',
      program: 'See the programme',
      online: 'Watch online',
      countdownLabel: 'Until the festival opens',
      countdownProvisional: 'To the provisional date',
      live: 'The festival is on!',
      units: ['days', 'hrs', 'min'],
      artAlt: 'Illustration from the poster of the XXV MASSKA edition: tree bark with two holes like eyes above a sunflower head',
    };
---

<section class="jubilee-hero" aria-labelledby="jubilee-title">
    <div class="jubilee-hero__inner">
        <div class="jubilee-hero__text">
            <h1 id="jubilee-title" class="jubilee-hero__title">
                <span class="sr-only">{t.title}</span>
                <JubileePlate base="../" />
            </h1>

            <p class="jubilee-hero__lead">{t.lead}</p>

            <dl class="jubilee-hero__facts">
                <div>
                    <dt>{t.when}</dt>
                    <dd>
                        <time datetime={edition.start.slice(0, 10)}>{edition.dateLabel[lang]}</time>
                        {!edition.datesConfirmed && <span class="jubilee-hero__detail">{t.provisional}</span>}
                    </dd>
                </div>
                <div>
                    <dt>{t.where}</dt>
                    <dd>
                        {edition.venue.shortName}, {edition.venue.city}
                        <span class="jubilee-hero__detail">{edition.venue.street}</span>
                    </dd>
                </div>
                <div
                    class="countdown"
                    data-countdown
                    data-start={edition.start}
                    data-end={edition.end}
                    hidden
                >
                    <dt class="countdown__label">
                        {edition.datesConfirmed ? t.countdownLabel : t.countdownProvisional}
                    </dt>
                    <dd>
                        <ol class="countdown__units" role="list">
                            {t.units.map((unit, i) => (
                                <li>
                                    <span class="countdown__value" data-countdown-part={i}>–</span>
                                    <span class="countdown__unit">{unit}</span>
                                </li>
                            ))}
                        </ol>
                        <span class="countdown__live" hidden>{t.live}</span>
                    </dd>
                </div>
            </dl>

            <div class="hero-actions">
                <a class="button primary" href="program.html">{t.program}</a>
                <a class="button secondary" href="online.html">{t.online}</a>
            </div>
        </div>

        <figure class="jubilee-hero__art">
            <img
                src={edition.posterArt}
                alt={t.artAlt}
                width={edition.posterArtSize.width}
                height={edition.posterArtSize.height}
                decoding="async"
            />
        </figure>
    </div>
</section>

<script>
    // Countdown to the festival start, computed once on load. It deliberately does not tick:
    // content that keeps updating on its own would need a pause control (WCAG 2.2.2).
    // Hidden without JS and after the festival.
    document.querySelectorAll<HTMLElement>('[data-countdown]').forEach((root) => {
        const start = Date.parse(root.dataset.start ?? '');
        const end = Date.parse(root.dataset.end ?? '');
        if (Number.isNaN(start) || Number.isNaN(end) || Date.now() > end) return;

        const diff = start - Date.now();
        if (diff <= 0) {
            root.querySelector<HTMLElement>('.countdown__units')?.setAttribute('hidden', '');
            root.querySelector<HTMLElement>('.countdown__live')?.removeAttribute('hidden');
        } else {
            const minutes = Math.floor(diff / 60000);
            const values = [Math.floor(minutes / 1440), Math.floor((minutes % 1440) / 60), minutes % 60];
            const parts = root.querySelectorAll<HTMLElement>('[data-countdown-part]');
            const show = (el: HTMLElement, i: number, v: number) => {
                el.textContent = i === 0 ? String(v) : String(v).padStart(2, '0');
            };
            parts.forEach((el, i) => show(el, i, values[i]));

            // A one-off count-up from zero when the page opens (skipped with reduced motion);
            // the real numbers are already in the page and are what remains afterwards
            if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
                const duration = 1100;
                const startedAt = performance.now();
                const tick = (now: number) => {
                    const t = Math.min((now - startedAt) / duration, 1);
                    const eased = 1 - Math.pow(1 - t, 3);
                    parts.forEach((el, i) => show(el, i, Math.round(values[i] * eased)));
                    if (t < 1) requestAnimationFrame(tick);
                };
                parts.forEach((el, i) => show(el, i, 0));
                requestAnimationFrame(tick);
            }
        }
        root.hidden = false;
    });
</script>

<style>
    .jubilee-hero {
        position: relative;
        padding: clamp(1.5rem, 4vw, 3.5rem) var(--gutter) clamp(2.5rem, 5vw, 4rem);
        background:
            radial-gradient(circle at 88% 15%, var(--color-blue-soft) 0, transparent 55%),
            var(--color-bg);
    }

    .jubilee-hero__inner {
        max-width: var(--max-width);
        margin: 0 auto;
        display: grid;
        gap: clamp(1.5rem, 4vw, 3rem);
        align-items: center;
    }

    @media (min-width: 900px) {
        .jubilee-hero__inner {
            grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
        }
    }

    .jubilee-hero__text {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-md);
    }

    .jubilee-hero__title {
        margin: 0;
        font-size: 1rem;
        text-transform: none;
    }

    .jubilee-hero__lead {
        max-width: 38rem;
        margin: 0;
        font-size: 1.05rem;
    }

    .jubilee-hero__facts {
        display: flex;
        flex-wrap: wrap;
        align-items: stretch;
        gap: var(--spacing-sm) var(--spacing-lg);
        margin: 0;
        padding: var(--spacing-md) 0;
        border-block: 1px solid var(--color-border);
    }

    .jubilee-hero__facts dt {
        font-size: 0.75rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--color-muted);
    }

    .jubilee-hero__facts dd {
        display: grid;
        margin: 0.15rem 0 0;
        font-family: var(--font-family-headers);
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--color-text);
    }

    .jubilee-hero__detail {
        font-family: var(--font-family-base);
        font-size: 0.8rem;
        font-weight: var(--font-weight-regular);
        color: var(--color-blue-strong);
    }

    .jubilee-hero .hero-actions {
        margin: 0;
    }

    /* Countdown: a blue chip in the facts row */
    .countdown {
        padding: 0.45rem 1rem 0.55rem;
        border-radius: var(--radius-sm);
        background: var(--color-blue);
    }

    .countdown[hidden] {
        display: none;
    }

    .jubilee-hero__facts .countdown dt {
        color: var(--color-blue-strong);
        font-weight: var(--font-weight-medium);
    }

    .jubilee-hero__facts .countdown dd {
        display: block;
        margin: 0;
    }

    .countdown__units {
        display: flex;
        gap: 0.9rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .countdown__units[hidden],
    .countdown__live[hidden] {
        display: none;
    }

    .countdown__units li {
        display: flex;
        align-items: baseline;
        gap: 0.25rem;
    }

    .countdown__value {
        font-size: 1.6rem;
        line-height: 1.1;
        font-variant-numeric: tabular-nums;
        color: var(--color-ink);
    }

    .countdown__unit {
        font-family: var(--font-family-base);
        font-size: 0.75rem;
        font-weight: var(--font-weight-regular);
        color: var(--color-blue-strong);
    }

    .countdown__live {
        font-size: 1.25rem;
        color: var(--color-ink);
    }

    /* Artwork of the poster, in a card with an offset block in the poster's blue */
    .jubilee-hero__art {
        position: relative;
        justify-self: center;
        width: min(100%, 25rem);
        margin: 0 1.25rem 1.25rem 0;
    }

    .jubilee-hero__art::before {
        content: '';
        position: absolute;
        inset: 1.25rem -1.25rem -1.25rem 1.25rem;
        border-radius: var(--radius-md);
        background: var(--color-blue);
    }

    .jubilee-hero__art img {
        position: relative;
        width: 100%;
        height: auto;
        border-radius: var(--radius-md);
        box-shadow: var(--shadow-lg);
    }

    /* The artwork tilts in, then its blue block grows behind it; afterwards it drifts down a
       little while the page scrolls (scroll-driven, so nothing moves on its own) */
    @media (prefers-reduced-motion: no-preference) {
        .jubilee-hero__art img {
            animation: art-in 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) 0.35s both;
        }

        .jubilee-hero__art::before {
            transform-origin: 0 0;
            animation: art-block 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) 0.75s both;
        }
    }

    @supports (animation-timeline: scroll()) {
        @media (prefers-reduced-motion: no-preference) {
            .jubilee-hero__art {
                animation: art-drift linear both;
                animation-timeline: scroll(root);
                animation-range: 0 70vh;
            }
        }
    }

    @keyframes art-in {
        from {
            opacity: 0;
            translate: 0 36px;
            rotate: 3deg;
        }
    }

    @keyframes art-block {
        from {
            opacity: 0;
            scale: 0.7;
        }
    }

    @keyframes art-drift {
        to {
            translate: 0 56px;
            rotate: 1.5deg;
        }
    }

    @media (max-width: 899px) {
        .jubilee-hero__art {
            width: min(78%, 20rem);
        }
    }
</style>
