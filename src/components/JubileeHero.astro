---
import { edition, type Lang } from '../data/edition';
import JubileePlate from './JubileePlate.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const isPl = lang === 'pl';

const t = isPl
  ? {
      title: `${edition.numeral} Jubileuszowy Międzynarodowy Przegląd Teatralny MASSKA ${edition.year}`,
      lead: 'Od ćwierć wieku Masska zbiera na jednej scenie teatry z Polski i z zagranicy. Na jubileusz zapraszamy do Sopotu: na spektakle, warsztaty i spotkania z twórcami, na żywo i online.',
      when: 'Termin',
      where: 'Miejsce',
      provisional: 'termin do potwierdzenia',
      program: 'Zobacz program',
      online: 'Oglądaj online',
      countdownLabel: 'Do otwarcia festiwalu',
      countdownNext: 'Do kolejnego dnia festiwalu',
      countdownProvisional: 'Do terminu orientacyjnego',
      live: 'Festiwal trwa!',
      units: ['dni', 'godz.', 'min'],
      horn: 'Dmuchnij w trąbkę urodzinową',
    }
  : {
      title: `${edition.numeral} MASSKA Anniversary International Theatre Review ${edition.year}`,
      lead: 'For a quarter of a century Masska has brought theatres from Poland and abroad onto one stage. For the anniversary we invite you to Sopot: performances, workshops and meetings with the artists, live and online.',
      when: 'Dates',
      where: 'Venue',
      provisional: 'dates to be confirmed',
      program: 'See the programme',
      online: 'Watch online',
      countdownLabel: 'Until the festival opens',
      countdownNext: 'Until the next festival day',
      countdownProvisional: 'To the provisional date',
      live: 'The festival is on!',
      units: ['days', 'hrs', 'min'],
      horn: 'Blow the party horn',
    };
---

<section class="jubilee-hero" aria-labelledby="jubilee-title">
    <div class="jubilee-hero__inner">
        <div class="jubilee-hero__text">
            <h1 id="jubilee-title" class="jubilee-hero__title">
                <span class="sr-only">{t.title}</span>
                <JubileePlate base="../" />
            </h1>

            <p class="jubilee-hero__lead">{t.lead}</p>

            <dl class="jubilee-hero__facts">
                <div>
                    <dt>{t.when}</dt>
                    <dd>
                        <time datetime={edition.start.slice(0, 10)}>{edition.dateLabel[lang]}</time>
                        {!edition.datesConfirmed && <span class="jubilee-hero__detail">{t.provisional}</span>}
                    </dd>
                </div>
                <div>
                    <dt>{t.where}</dt>
                    <dd>
                        {edition.places.map((place) => (
                            <span class="jubilee-hero__place">
                                {place.when[lang]} · {place.venue.shortName}
                                <span class="jubilee-hero__detail">{place.venue.street}, {place.venue.city}</span>
                            </span>
                        ))}
                    </dd>
                </div>
                <div
                    class="countdown"
                    data-countdown
                    data-schedule={JSON.stringify(edition.schedule)}
                    data-label-next={t.countdownNext}
                    hidden
                >
                    <dt class="countdown__label" data-countdown-label>
                        {edition.datesConfirmed ? t.countdownLabel : t.countdownProvisional}
                    </dt>
                    <dd>
                        <ol class="countdown__units" role="list">
                            {t.units.map((unit, i) => (
                                <li>
                                    <span class="countdown__value" data-countdown-part={i}>–</span>
                                    <span class="countdown__unit">{unit}</span>
                                </li>
                            ))}
                        </ol>
                        <span class="countdown__live" hidden>{t.live}</span>
                    </dd>
                </div>
            </dl>

            <div class="hero-actions">
                <a class="button primary" href="program.html">{t.program}</a>
                <a class="button secondary" href="online.html">{t.online}</a>
            </div>
        </div>

        <figure class="jubilee-hero__art">
            <img
                src={edition.posterArt}
                alt={edition.posterArtAlt[lang]}
                width={edition.posterArtSize.width}
                height={edition.posterArtSize.height}
                decoding="async"
            />
            <!-- The candles on the hat are lit once the page opens -->
            <span class="flame flame--left" aria-hidden="true"></span>
            <span class="flame flame--right" aria-hidden="true"></span>
            <!-- A tap on the head: the party horn unrolls from the lips -->
            <svg class="horn" viewBox="0 0 900 1246" aria-hidden="true" focusable="false">
                <path class="horn__outline"></path>
                <path class="horn__base"></path>
                <path class="horn__stripes"></path>
                <circle class="horn__tip" r="1"></circle>
            </svg>
            <button type="button" class="horn-trigger" data-horn aria-label={t.horn}></button>
        </figure>
    </div>
</section>

<script>
    // Countdown to the festival start, computed once on load. It deliberately does not tick:
    // content that keeps updating on its own would need a pause control (WCAG 2.2.2).
    // Hidden without JS and after the festival.
    document.querySelectorAll<HTMLElement>('[data-countdown]').forEach((root) => {
        const days = (JSON.parse(root.dataset.schedule ?? '[]') as { start: string; end: string }[])
            .map((day) => ({ start: Date.parse(day.start), end: Date.parse(day.end) }))
            .filter((day) => !Number.isNaN(day.start) && !Number.isNaN(day.end))
            .sort((a, b) => a.start - b.start);
        const now = Date.now();
        const current = days.find((day) => now >= day.start && now <= day.end);
        const upcoming = days.find((day) => day.start > now);
        // Nothing to count to once the last day is over
        if (!current && !upcoming) return;

        if (current) {
            root.querySelector<HTMLElement>('.countdown__units')?.setAttribute('hidden', '');
            root.querySelector<HTMLElement>('.countdown__live')?.removeAttribute('hidden');
        } else if (upcoming) {
            // Between the days (including the break between the 13th and the 15th): count to the next one
            if (now > days[0].start) {
                const label = root.querySelector<HTMLElement>('[data-countdown-label]');
                if (label && root.dataset.labelNext) label.textContent = root.dataset.labelNext;
            }
            const minutes = Math.floor((upcoming.start - now) / 60000);
            const values = [Math.floor(minutes / 1440), Math.floor((minutes % 1440) / 60), minutes % 60];
            const parts = root.querySelectorAll<HTMLElement>('[data-countdown-part]');
            const show = (el: HTMLElement, i: number, v: number) => {
                el.textContent = i === 0 ? String(v) : String(v).padStart(2, '0');
            };
            parts.forEach((el, i) => show(el, i, values[i]));

            // A one-off count-up from zero when the page opens (skipped with reduced motion);
            // the real numbers are already in the page and are what remains afterwards
            if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
                const duration = 1100;
                const startedAt = performance.now();
                const tick = (time: number) => {
                    const t = Math.min((time - startedAt) / duration, 1);
                    const eased = 1 - Math.pow(1 - t, 3);
                    parts.forEach((el, i) => show(el, i, Math.round(values[i] * eased)));
                    if (t < 1) requestAnimationFrame(tick);
                };
                parts.forEach((el, i) => show(el, i, 0));
                requestAnimationFrame(tick);
            }
        }
        root.hidden = false;
    });
</script>

<script>
    // The flames lean with the phone's gyroscope, sideways only (the left-right tilt of the phone held
    // upright). They keep pointing up in the room, so they turn against the phone. Not with reduced motion.
    const flames = document.querySelectorAll<HTMLElement>('.jubilee-hero .flame');
    const motionOk = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (flames.length && motionOk && 'DeviceOrientationEvent' in window) {
        const MAX = 28; // degrees of lean at most
        let target = 0;
        let lean = 0;
        let running = false;

        const frame = () => {
            lean += (target - lean) * 0.12;
            flames.forEach((flame) => flame.style.setProperty('--lean', lean.toFixed(2)));
            if (Math.abs(target - lean) > 0.05) requestAnimationFrame(frame);
            else running = false;
        };

        const onTilt = (event: DeviceOrientationEvent) => {
            if (event.gamma === null) return;
            // Held upright (0 or 180), the left-right tilt is gamma; sideways the axes swap, so the lean is left
            const angle = screen.orientation?.angle ?? 0;
            if (angle !== 0 && angle !== 180) {
                target = 0;
            } else {
                const side = angle === 180 ? -event.gamma : event.gamma;
                target = Math.max(-MAX, Math.min(MAX, -side * 0.8));
            }
            if (!running) {
                running = true;
                requestAnimationFrame(frame);
            }
        };

        const listen = () => window.addEventListener('deviceorientation', onTilt, { passive: true });
        const needsPermission = typeof (DeviceOrientationEvent as any).requestPermission === 'function';
        if (needsPermission) {
            // iOS asks once, and only from a tap
            const ask = () => {
                (DeviceOrientationEvent as any)
                    .requestPermission()
                    .then((answer: string) => answer === 'granted' && listen())
                    .catch(() => {});
            };
            window.addEventListener('pointerup', ask, { once: true });
        } else {
            listen();
        }
    }
</script>

<script>
    // A tap on the head and the party horn unrolls from the lips, wobbles and rolls back up.
    // The horn is a tube of fixed length: the unrolled part is straight, the rest is wound into
    // a spiral at its end, so the stripes stay on the same spots of the paper as it unrolls.
    const trigger = document.querySelector<HTMLButtonElement>('[data-horn]');
    const horn = document.querySelector<SVGSVGElement>('.horn');
    if (trigger && horn) {
        const paths = horn.querySelectorAll<SVGPathElement>('path');
        const tip = horn.querySelector<SVGCircleElement>('.horn__tip')!;
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
        const MOUTH = { x: 505, y: 708 }; // the lips, in pixels of the 900x1246 artwork
        const LENGTH = 250; // of the whole tube
        const PITCH = 3.2; // distance between the turns of the spiral, per radian
        const CORE = 8; // radius of the innermost turn
        const STEP = 3;
        const UNROLL = 420;
        const HOLD = 1500;
        const ROLL_UP = 700;
        const ease = (t: number) => 1 - Math.pow(1 - t, 3);
        const easeInOut = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

        // The tube when `open` (0..1) of it is unrolled
        const draw = (open: number, shake: number) => {
            const straight = open * LENGTH;
            const coil = LENGTH - straight;
            const angle = ((-3 + shake) * Math.PI) / 180;
            let x = MOUTH.x + Math.cos(angle) * straight;
            let y = MOUTH.y + Math.sin(angle) * straight;
            tip.setAttribute('cx', x.toFixed(1));
            tip.setAttribute('cy', y.toFixed(1));
            let d = `M${MOUTH.x} ${MOUTH.y}L${x.toFixed(1)} ${y.toFixed(1)}`;
            if (coil > 1) {
                const joint = Math.sqrt(2 * PITCH * coil + CORE * CORE); // radius of the outer turn
                let turned = 0;
                for (let length = 0, n = 0; length < coil && n < 300; n++) {
                    const step = Math.min(STEP, coil - length);
                    const radius = Math.max(CORE, joint - PITCH * turned);
                    turned += step / radius;
                    length += step;
                    x += Math.cos(angle - turned) * step;
                    y += Math.sin(angle - turned) * step;
                    d += `L${x.toFixed(1)} ${y.toFixed(1)}`;
                }
            }
            paths.forEach((path) => path.setAttribute('d', d));
        };

        let running = false;
        const play = () => {
            if (running) return;
            running = true;
            horn.classList.add('is-open');
            let party = false;
            const startedAt = performance.now();

            const finish = () => {
                horn.classList.remove('is-open');
                running = false;
            };
            const celebrate = () => {
                party = true;
                document.dispatchEvent(new CustomEvent('masska:party', { detail: { from: tip } }));
            };

            if (reduce.matches) {
                draw(1, 0);
                setTimeout(finish, 2000);
                return;
            }

            const frame = (now: number) => {
                const t = now - startedAt;
                let open = 1;
                let shake = 0;
                if (t < UNROLL) {
                    open = ease(t / UNROLL);
                    shake = 5 * Math.sin(t / 18) * (1 - t / UNROLL);
                } else if (t < UNROLL + HOLD) {
                    shake = 2.2 * Math.sin(t / 55) * Math.max(0, 1 - (t - UNROLL) / 700);
                } else {
                    open = 1 - easeInOut(Math.min(1, (t - UNROLL - HOLD) / ROLL_UP));
                }
                draw(open, shake);
                if (!party && open > 0.9) celebrate();
                if (t < UNROLL + HOLD + ROLL_UP) requestAnimationFrame(frame);
                else finish();
            };
            requestAnimationFrame(frame);
        };

        draw(0, 0);
        trigger.addEventListener('click', play);
    }
</script>

<style>
    .jubilee-hero {
        position: relative;
        padding: clamp(1.5rem, 4vw, 3.5rem) var(--gutter) clamp(2.5rem, 5vw, 4rem);
        background: var(--color-bg);
    }

    .jubilee-hero__inner {
        max-width: var(--max-width);
        margin: 0 auto;
        display: grid;
        gap: clamp(1.5rem, 4vw, 3rem);
        align-items: center;
    }

    @media (min-width: 900px) {
        .jubilee-hero__inner {
            grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
        }
    }

    .jubilee-hero__text {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-md);
    }

    .jubilee-hero__title {
        margin: 0;
        font-size: 1rem;
        text-transform: none;
    }

    .jubilee-hero__lead {
        max-width: 38rem;
        margin: 0;
        font-size: 1.05rem;
    }

    .jubilee-hero__facts {
        display: flex;
        flex-wrap: wrap;
        align-items: stretch;
        gap: var(--spacing-sm) var(--spacing-lg);
        margin: 0;
        padding: var(--spacing-md) 0;
        border-block: 1px solid var(--color-border);
    }

    .jubilee-hero__facts dt {
        font-size: 0.75rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--color-muted);
    }

    .jubilee-hero__facts dd {
        display: grid;
        margin: 0.15rem 0 0;
        font-family: var(--font-family-headers);
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--color-text);
    }

    .jubilee-hero__place {
        display: grid;
        margin-bottom: 0.35rem;
        font-size: 1.05rem;
    }

    .jubilee-hero__detail {
        font-family: var(--font-family-base);
        font-size: 0.8rem;
        font-weight: var(--font-weight-regular);
        color: var(--color-grey-strong);
    }

    .jubilee-hero .hero-actions {
        margin: 0;
    }

    /* Narrower screens: the figure stands next to the lettering, as on the poster, instead of
       coming after all the text; the rest of the text runs below both at full width */
    @media (max-width: 899px) {
        .jubilee-hero__inner {
            grid-template-columns: minmax(0, 1fr) minmax(0, 0.72fr);
            gap: var(--spacing-md) clamp(0.75rem, 3vw, 1.5rem);
            align-items: end;
        }

        .jubilee-hero__text {
            display: contents;
        }

        .jubilee-hero__title {
            grid-row: 1;
            grid-column: 1;
        }

        .jubilee-hero__art {
            grid-row: 1;
            grid-column: 2;
        }

        .jubilee-hero__lead,
        .jubilee-hero__facts,
        .jubilee-hero .hero-actions {
            grid-column: 1 / -1;
        }
    }

    /* Countdown: a black block in the facts row, like the suit on the poster */
    .countdown {
        padding: 0.45rem 1rem 0.55rem;
        border-radius: var(--radius-ui);
        background: #111111;
        box-shadow: 4px 4px 0 var(--color-red);
    }

    .countdown[hidden] {
        display: none;
    }

    .jubilee-hero__facts .countdown dt {
        color: #ff9f8a;
        font-weight: var(--font-weight-medium);
    }

    .jubilee-hero__facts .countdown dd {
        display: block;
        margin: 0;
    }

    .countdown__units {
        display: flex;
        gap: 0.9rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .countdown__units[hidden],
    .countdown__live[hidden] {
        display: none;
    }

    .countdown__units li {
        display: flex;
        align-items: baseline;
        gap: 0.25rem;
    }

    .countdown__value {
        font-size: 1.6rem;
        line-height: 1.1;
        font-variant-numeric: tabular-nums;
        color: #ffffff;
    }

    .countdown__unit {
        font-family: var(--font-family-base);
        font-size: 0.75rem;
        font-weight: var(--font-weight-regular);
        color: #d2d2d2;
    }

    .countdown__live {
        font-size: 1.25rem;
        color: #ffffff;
    }

    :global(body.high-contrast) .countdown {
        background: #000000;
        border: 2px solid var(--color-text);
        box-shadow: none;
    }

    :global(body.high-contrast) .jubilee-hero__facts .countdown dt {
        color: var(--color-accent);
    }

    /* The figure of the poster, straight on the white page as on the poster itself */
    .jubilee-hero__art {
        position: relative;
        justify-self: center;
        width: min(100%, 30rem);
        margin: 1.5rem 0 0;
    }

    .jubilee-hero__art img {
        position: relative;
        width: 100%;
        height: auto;
        border-radius: 0;
    }

    /* In high contrast the white of the artwork would glare on the black page */
    :global(body.high-contrast) .jubilee-hero__art img {
        border-radius: var(--radius-md);
        opacity: 0.92;
    }

    /* The party horn: black outline, white paper, red stripes (the inks of the poster) */
    .horn {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        overflow: visible;
        fill: none;
        stroke-linecap: round;
        stroke-linejoin: round;
        pointer-events: none;
        visibility: hidden;
    }

    .horn.is-open {
        visibility: visible;
    }

    .horn__outline {
        stroke: #111111;
        stroke-width: 30;
    }

    .horn__base {
        stroke: #ffffff;
        stroke-width: 20;
    }

    .horn__stripes {
        stroke: #d32f13;
        stroke-width: 20;
        stroke-linecap: butt;
        stroke-dasharray: 16 16;
    }

    .horn__tip {
        fill: none;
        stroke: none;
    }

    /* The head of the figure: hat and face */
    .horn-trigger {
        position: absolute;
        left: 6%;
        top: 9%;
        width: 88%;
        height: 72%;
        padding: 0;
        border: 0;
        border-radius: 45% 45% 30% 30%;
        background: transparent;
        color: inherit;
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
    }

    .horn-trigger:focus-visible {
        outline: 3px solid var(--color-red);
        outline-offset: 2px;
    }

    :global(body.high-contrast) .horn-trigger:focus-visible {
        outline-color: var(--color-accent);
    }

    /* Flames on the two wicks (their tips are at these points of the artwork) */
    .flame {
        position: absolute;
        width: 3.2%;
        aspect-ratio: 1 / 1.9;
        translate: -50% -96%;
        border-radius: 50% 50% 45% 45% / 62% 62% 38% 38%;
        background: radial-gradient(ellipse at 50% 72%, #fff6c9 0 18%, #ffc531 38%, #ff7a1a 64%, rgba(211, 47, 19, 0) 72%);
        filter: blur(0.3px) drop-shadow(0 0 0.4em rgba(255, 150, 40, 0.65));
        transform-origin: 50% 100%;
        /* The lean the gyroscope sets (degrees); the flame keeps pointing up in the room */
        transform: rotate(calc(var(--lean, 0) * 1deg));
        pointer-events: none;
    }

    .flame--left {
        left: 47.8%;
        top: 0.56%;
    }

    .flame--right {
        left: 57.6%;
        top: 1.12%;
    }

    /* The figure rises in and the candles catch fire; the flames then flicker without stopping,
       each at its own pace. Only with reduced motion off: the flames then burn still and do not lean. */
    @media (prefers-reduced-motion: no-preference) {
        .jubilee-hero__art img {
            animation: art-in 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) 0.35s both;
        }

        .flame {
            animation:
                flame-light 0.5s cubic-bezier(0.2, 1.4, 0.4, 1) var(--d) both,
                flame-flicker var(--flicker) ease-in-out calc(var(--d) + 0.5s) infinite alternate;
        }

        .flame--left {
            --d: 1.2s;
            --flicker: 0.43s;
        }

        .flame--right {
            --d: 1.45s;
            --flicker: 0.57s;
        }
    }

    /* The drift only beside the text column: next to the lettering it would slide into the lead */
    @supports (animation-timeline: scroll()) {
        @media (prefers-reduced-motion: no-preference) and (min-width: 900px) {
            .jubilee-hero__art {
                animation: art-drift linear both;
                animation-timeline: scroll(root);
                animation-range: 0 70vh;
            }
        }
    }

    @keyframes art-in {
        from {
            opacity: 0;
            translate: 0 36px;
        }
    }

    @keyframes flame-light {
        from {
            opacity: 0;
            scale: 0.2;
        }
    }

    @keyframes flame-flicker {
        from {
            scale: 1 1;
            rotate: -3deg;
        }

        45% {
            scale: 0.94 1.04;
            rotate: 2deg;
        }

        to {
            scale: 0.86 1.12;
            rotate: 4.5deg;
        }
    }

    @keyframes art-drift {
        to {
            translate: 0 48px;
        }
    }

    @media (max-width: 899px) {
        .jubilee-hero__art {
            width: 100%;
            max-width: 22rem;
            margin: 0;
        }
    }
</style>
