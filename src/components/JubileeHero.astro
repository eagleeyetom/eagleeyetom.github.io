---
import { edition, type Lang } from '../data/edition';
import JubileePlate from './JubileePlate.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const isPl = lang === 'pl';

const t = isPl
  ? {
      title: `${edition.numeral} Jubileuszowy Międzynarodowy Przegląd Teatralny MASSKA ${edition.year}`,
      lead: 'Od ćwierć wieku Masska zbiera na jednej scenie teatry z Polski i z zagranicy. Na jubileusz zapraszamy do Sopotu: na spektakle, warsztaty i spotkania z twórcami, na żywo i online.',
      when: 'Termin',
      where: 'Miejsce',
      provisional: 'termin do potwierdzenia',
      program: 'Zobacz program',
      online: 'Oglądaj online',
      countdownLabel: 'Do otwarcia festiwalu',
      countdownNext: 'Do kolejnego dnia festiwalu',
      countdownProvisional: 'Do terminu orientacyjnego',
      live: 'Festiwal trwa!',
      units: ['dni', 'godz.', 'min'],
    }
  : {
      title: `${edition.numeral} MASSKA Anniversary International Theatre Review ${edition.year}`,
      lead: 'For a quarter of a century Masska has brought theatres from Poland and abroad onto one stage. For the anniversary we invite you to Sopot: performances, workshops and meetings with the artists, live and online.',
      when: 'Dates',
      where: 'Venue',
      provisional: 'dates to be confirmed',
      program: 'See the programme',
      online: 'Watch online',
      countdownLabel: 'Until the festival opens',
      countdownNext: 'Until the next festival day',
      countdownProvisional: 'To the provisional date',
      live: 'The festival is on!',
      units: ['days', 'hrs', 'min'],
    };
---

<section class="jubilee-hero" aria-labelledby="jubilee-title">
    <div class="jubilee-hero__inner">
        <div class="jubilee-hero__text">
            <h1 id="jubilee-title" class="jubilee-hero__title">
                <span class="sr-only">{t.title}</span>
                <JubileePlate base="../" />
            </h1>

            <p class="jubilee-hero__lead">{t.lead}</p>

            <dl class="jubilee-hero__facts">
                <div>
                    <dt>{t.when}</dt>
                    <dd>
                        <time datetime={edition.start.slice(0, 10)}>{edition.dateLabel[lang]}</time>
                        {!edition.datesConfirmed && <span class="jubilee-hero__detail">{t.provisional}</span>}
                    </dd>
                </div>
                <div>
                    <dt>{t.where}</dt>
                    <dd>
                        {edition.places.map((place) => (
                            <span class="jubilee-hero__place">
                                {place.when[lang]} · {place.venue.shortName}
                                <span class="jubilee-hero__detail">{place.venue.street}, {place.venue.city}</span>
                            </span>
                        ))}
                    </dd>
                </div>
                <div
                    class="countdown"
                    data-countdown
                    data-schedule={JSON.stringify(edition.schedule)}
                    data-label-next={t.countdownNext}
                    hidden
                >
                    <dt class="countdown__label" data-countdown-label>
                        {edition.datesConfirmed ? t.countdownLabel : t.countdownProvisional}
                    </dt>
                    <dd>
                        <ol class="countdown__units" role="list">
                            {t.units.map((unit, i) => (
                                <li>
                                    <span class="countdown__value" data-countdown-part={i}>–</span>
                                    <span class="countdown__unit">{unit}</span>
                                </li>
                            ))}
                        </ol>
                        <span class="countdown__live" hidden>{t.live}</span>
                    </dd>
                </div>
            </dl>

            <div class="hero-actions">
                <a class="button primary" href="program.html">{t.program}</a>
                <a class="button secondary" href="online.html">{t.online}</a>
            </div>
        </div>

        <figure class="jubilee-hero__art">
            <img
                src={edition.posterArt}
                alt={edition.posterArtAlt[lang]}
                width={edition.posterArtSize.width}
                height={edition.posterArtSize.height}
                decoding="async"
            />
            <!-- The candles on the hat are lit once the page opens -->
            <span class="flame flame--left" aria-hidden="true"></span>
            <span class="flame flame--right" aria-hidden="true"></span>
        </figure>
    </div>
</section>

<script>
    // Countdown to the festival start, computed once on load. It deliberately does not tick:
    // content that keeps updating on its own would need a pause control (WCAG 2.2.2).
    // Hidden without JS and after the festival.
    document.querySelectorAll<HTMLElement>('[data-countdown]').forEach((root) => {
        const days = (JSON.parse(root.dataset.schedule ?? '[]') as { start: string; end: string }[])
            .map((day) => ({ start: Date.parse(day.start), end: Date.parse(day.end) }))
            .filter((day) => !Number.isNaN(day.start) && !Number.isNaN(day.end))
            .sort((a, b) => a.start - b.start);
        const now = Date.now();
        const current = days.find((day) => now >= day.start && now <= day.end);
        const upcoming = days.find((day) => day.start > now);
        // Nothing to count to once the last day is over
        if (!current && !upcoming) return;

        if (current) {
            root.querySelector<HTMLElement>('.countdown__units')?.setAttribute('hidden', '');
            root.querySelector<HTMLElement>('.countdown__live')?.removeAttribute('hidden');
        } else if (upcoming) {
            // Between the days (including the break between the 13th and the 15th): count to the next one
            if (now > days[0].start) {
                const label = root.querySelector<HTMLElement>('[data-countdown-label]');
                if (label && root.dataset.labelNext) label.textContent = root.dataset.labelNext;
            }
            const minutes = Math.floor((upcoming.start - now) / 60000);
            const values = [Math.floor(minutes / 1440), Math.floor((minutes % 1440) / 60), minutes % 60];
            const parts = root.querySelectorAll<HTMLElement>('[data-countdown-part]');
            const show = (el: HTMLElement, i: number, v: number) => {
                el.textContent = i === 0 ? String(v) : String(v).padStart(2, '0');
            };
            parts.forEach((el, i) => show(el, i, values[i]));

            // A one-off count-up from zero when the page opens (skipped with reduced motion);
            // the real numbers are already in the page and are what remains afterwards
            if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
                const duration = 1100;
                const startedAt = performance.now();
                const tick = (time: number) => {
                    const t = Math.min((time - startedAt) / duration, 1);
                    const eased = 1 - Math.pow(1 - t, 3);
                    parts.forEach((el, i) => show(el, i, Math.round(values[i] * eased)));
                    if (t < 1) requestAnimationFrame(tick);
                };
                parts.forEach((el, i) => show(el, i, 0));
                requestAnimationFrame(tick);
            }
        }
        root.hidden = false;
    });
</script>

<style>
    .jubilee-hero {
        position: relative;
        padding: clamp(1.5rem, 4vw, 3.5rem) var(--gutter) clamp(2.5rem, 5vw, 4rem);
        background: var(--color-bg);
    }

    .jubilee-hero__inner {
        max-width: var(--max-width);
        margin: 0 auto;
        display: grid;
        gap: clamp(1.5rem, 4vw, 3rem);
        align-items: center;
    }

    @media (min-width: 900px) {
        .jubilee-hero__inner {
            grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
        }
    }

    .jubilee-hero__text {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-md);
    }

    .jubilee-hero__title {
        margin: 0;
        font-size: 1rem;
        text-transform: none;
    }

    .jubilee-hero__lead {
        max-width: 38rem;
        margin: 0;
        font-size: 1.05rem;
    }

    .jubilee-hero__facts {
        display: flex;
        flex-wrap: wrap;
        align-items: stretch;
        gap: var(--spacing-sm) var(--spacing-lg);
        margin: 0;
        padding: var(--spacing-md) 0;
        border-block: 1px solid var(--color-border);
    }

    .jubilee-hero__facts dt {
        font-size: 0.75rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--color-muted);
    }

    .jubilee-hero__facts dd {
        display: grid;
        margin: 0.15rem 0 0;
        font-family: var(--font-family-headers);
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--color-text);
    }

    .jubilee-hero__place {
        display: grid;
        margin-bottom: 0.35rem;
        font-size: 1.05rem;
    }

    .jubilee-hero__detail {
        font-family: var(--font-family-base);
        font-size: 0.8rem;
        font-weight: var(--font-weight-regular);
        color: var(--color-grey-strong);
    }

    .jubilee-hero .hero-actions {
        margin: 0;
    }

    /* Countdown: a black block in the facts row, like the suit on the poster */
    .countdown {
        padding: 0.45rem 1rem 0.55rem;
        border-radius: var(--radius-ui);
        background: #111111;
        box-shadow: 4px 4px 0 var(--color-red);
    }

    .countdown[hidden] {
        display: none;
    }

    .jubilee-hero__facts .countdown dt {
        color: #ff9f8a;
        font-weight: var(--font-weight-medium);
    }

    .jubilee-hero__facts .countdown dd {
        display: block;
        margin: 0;
    }

    .countdown__units {
        display: flex;
        gap: 0.9rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .countdown__units[hidden],
    .countdown__live[hidden] {
        display: none;
    }

    .countdown__units li {
        display: flex;
        align-items: baseline;
        gap: 0.25rem;
    }

    .countdown__value {
        font-size: 1.6rem;
        line-height: 1.1;
        font-variant-numeric: tabular-nums;
        color: #ffffff;
    }

    .countdown__unit {
        font-family: var(--font-family-base);
        font-size: 0.75rem;
        font-weight: var(--font-weight-regular);
        color: #d2d2d2;
    }

    .countdown__live {
        font-size: 1.25rem;
        color: #ffffff;
    }

    :global(body.high-contrast) .countdown {
        background: #000000;
        border: 2px solid var(--color-text);
        box-shadow: none;
    }

    :global(body.high-contrast) .jubilee-hero__facts .countdown dt {
        color: var(--color-accent);
    }

    /* The figure of the poster, straight on the white page as on the poster itself */
    .jubilee-hero__art {
        position: relative;
        justify-self: center;
        width: min(100%, 30rem);
        margin: 1.5rem 0 0;
    }

    .jubilee-hero__art img {
        position: relative;
        width: 100%;
        height: auto;
        border-radius: 0;
    }

    /* In high contrast the white of the artwork would glare on the black page */
    :global(body.high-contrast) .jubilee-hero__art img {
        border-radius: var(--radius-md);
        opacity: 0.92;
    }

    /* Flames on the two wicks (their tips are at these points of the artwork) */
    .flame {
        position: absolute;
        width: 3.2%;
        aspect-ratio: 1 / 1.9;
        translate: -50% -96%;
        border-radius: 50% 50% 45% 45% / 62% 62% 38% 38%;
        background: radial-gradient(ellipse at 50% 72%, #fff6c9 0 18%, #ffc531 38%, #ff7a1a 64%, rgba(211, 47, 19, 0) 72%);
        filter: blur(0.3px);
        transform-origin: 50% 100%;
        pointer-events: none;
    }

    .flame--left {
        left: 47.8%;
        top: 0.56%;
    }

    .flame--right {
        left: 57.6%;
        top: 1.12%;
    }

    /* The figure rises in and the candles catch fire; the flames flicker a few times and then
       burn steadily, so nothing keeps moving on its own (WCAG 2.2.2) */
    @media (prefers-reduced-motion: no-preference) {
        .jubilee-hero__art img {
            animation: art-in 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) 0.35s both;
        }

        .flame {
            animation:
                flame-light 0.5s cubic-bezier(0.2, 1.4, 0.4, 1) var(--d) both,
                flame-flicker 0.45s ease-in-out calc(var(--d) + 0.5s) 8 alternate;
        }

        .flame--left {
            --d: 1.2s;
        }

        .flame--right {
            --d: 1.45s;
        }
    }

    @supports (animation-timeline: scroll()) {
        @media (prefers-reduced-motion: no-preference) {
            .jubilee-hero__art {
                animation: art-drift linear both;
                animation-timeline: scroll(root);
                animation-range: 0 70vh;
            }
        }
    }

    @keyframes art-in {
        from {
            opacity: 0;
            translate: 0 36px;
        }
    }

    @keyframes flame-light {
        from {
            opacity: 0;
            scale: 0.2;
        }
    }

    @keyframes flame-flicker {
        from {
            scale: 1 1;
            rotate: -3deg;
        }

        to {
            scale: 0.88 1.1;
            rotate: 4deg;
        }
    }

    @keyframes art-drift {
        to {
            translate: 0 48px;
        }
    }

    @media (max-width: 899px) {
        .jubilee-hero__art {
            width: min(86%, 24rem);
        }
    }
</style>
