---
import { edition } from '../data/edition';

interface Props {
  lang: 'pl' | 'en';
}

const { lang } = Astro.props;
const isPl = lang === 'pl';

function getRelativeUrl(targetPath: string) {
  if (!targetPath) return '';
  if (targetPath.startsWith('http') || targetPath.startsWith('mailto:') || targetPath.startsWith('#')) {
    return targetPath;
  }
  
  let cleanPath = targetPath;
  if (cleanPath.startsWith('https://masska.org')) {
    cleanPath = cleanPath.substring(18);
  }
  
  if (cleanPath.startsWith('/pl/')) {
    const file = cleanPath.substring(4);
    return isPl ? file : `../pl/${file}`;
  }
  if (cleanPath.startsWith('/en/')) {
    const file = cleanPath.substring(4);
    return !isPl ? file : `../en/${file}`;
  }
  
  return cleanPath;
}
---

<footer class="footer" role="contentinfo" data-tone="dark">
    <div class="footer-inner">
        <div class="footer-columns">
            <section>
                <h2>{isPl ? "Kontakt" : "Contact"}</h2>
                <p><a href={getRelativeUrl(isPl ? "/pl/kontakt.html" : "/en/contact.html")}>{isPl ? "Formularz kontaktowy →" : "Contact form →"}</a></p>
                <div class="footer-socials">
                    <a href="https://www.facebook.com/masskasopot" target="_blank" rel="noopener noreferrer" aria-label="Facebook" title="Facebook">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                        </svg>
                    </a>
                    <a href="https://www.instagram.com/masska_przeglad_teatralny/" target="_blank" rel="noopener noreferrer" aria-label="Instagram" title="Instagram">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.051C.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/>
                        </svg>
                    </a>
                    <a href="https://www.youtube.com/@masskaprzegladteatralny" target="_blank" rel="noopener noreferrer" aria-label="YouTube" title="YouTube">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                            <path d="M23.498 6.163a3.003 3.003 0 0 0-2.11-2.11C19.518 3.545 12 3.545 12 3.545s-7.518 0-9.388.508a3.003 3.003 0 0 0-2.11 2.11C0 8.033 0 12 0 12s0 3.967.502 5.837a3.003 3.003 0 0 0 2.11 2.11c1.87.508 9.388.508 9.388.508s7.518 0 9.388-.508a3.003 3.003 0 0 0 2.11-2.11C24 15.967 24 12 24 12s0-3.967-.502-5.837zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                        </svg>
                    </a>
                </div>
            </section>
            <section>
                <h2>{isPl ? "Odwiedź na żywo" : "Visit in person"}</h2>
                <address class="footer-venue">
                    <strong>{edition.venue.name}</strong><br>
                    {edition.venue.street}, {edition.venue.city}
                </address>
                <!-- Google Maps loads only when asked for, so the page sends nothing to Google by default -->
                <div class="footer-map" data-map-embed={`https://www.google.com/maps?q=${encodeURIComponent(edition.venue.mapsQuery)}&hl=${lang}&output=embed`}
                    data-map-title={isPl ? `Mapa: ${edition.venue.shortName}, ${edition.venue.city}` : `Map: ${edition.venue.shortName}, ${edition.venue.city}`}>
                    <button type="button" class="button secondary" data-map-load>
                        {isPl ? "Pokaż mapę" : "Show map"}
                    </button>
                    <a class="button ghost" href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(edition.venue.mapsQuery)}`}
                        target="_blank" rel="noopener noreferrer">
                        {isPl ? "Otwórz w Mapach Google" : "Open in Google Maps"}
                        <span class="sr-only">{isPl ? "(otwiera się w nowej karcie)" : "(opens in a new tab)"}</span>
                    </a>
                    <p class="footer-map__note">
                        {isPl
                            ? "Mapa ładuje się z serwerów Google dopiero po kliknięciu."
                            : "The map loads from Google's servers only after you click."}
                    </p>
                </div>
            </section>
            <section>
                <h2>{isPl ? "Więcej informacji" : "More information"}</h2>
                <ul class="contact-list">
                    <li><a href={getRelativeUrl(isPl ? "/pl/online.html" : "/en/online.html")}>{isPl ? "Przewodnik po transmisji" : "Streaming guide"}</a></li>
                    <li><a href="https://docs.google.com/forms/d/1-cCnZtjLfHMI9uyEodcN6xm2t2ZBQPrVYIwB4eLu0yE/viewform"
                            target="_blank" rel="noopener noreferrer">{isPl ? "Zgłoszenie do wersji online" : "Online version submission"}</a></li>
                    <li><a href={getRelativeUrl(isPl ? "/pl/cookies.html" : "/en/cookies.html")}>{isPl ? "Polityka cookies" : "Cookie policy"}</a></li>
                </ul>
            </section>
        </div>
        <p class="footer-note">
            © {edition.year} {isPl ? "MASSKA Międzynarodowy Przegląd Teatralny" : "MASSKA International Theatre Review"}
        </p>
    </div>
</footer>

<script>
    // Swap the "Show map" button for the Google Maps iframe on request
    document.querySelectorAll<HTMLElement>('[data-map-embed]').forEach((box) => {
        const button = box.querySelector<HTMLButtonElement>('[data-map-load]');
        button?.addEventListener('click', () => {
            const iframe = document.createElement('iframe');
            iframe.src = box.dataset.mapEmbed ?? '';
            iframe.title = box.dataset.mapTitle ?? '';
            iframe.loading = 'lazy';
            iframe.referrerPolicy = 'no-referrer-when-downgrade';
            iframe.className = 'footer-map__frame';
            box.prepend(iframe);
            button.remove();
            box.querySelector('.footer-map__note')?.remove();
            iframe.focus();
        });
    });
</script>

<style>
    .footer-venue {
        font-style: normal;
        line-height: 1.6;
    }

    .footer-map {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 0.75rem;
    }

    .footer-map :global(.footer-map__frame) {
        width: 100%;
        height: 220px;
        border: 0;
        border-radius: var(--radius-sm);
    }

    .footer-map__note {
        flex-basis: 100%;
        margin: 0;
        font-size: 0.8rem;
    }
</style>
