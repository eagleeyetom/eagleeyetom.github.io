---
import { getCollection } from 'astro:content';
import { edition } from '../data/edition';
import WorldMap from './WorldMap.astro';

interface Props {
  lang: 'pl' | 'en';
}

const { lang } = Astro.props;
const isPl = lang === 'pl';

const t = isPl
  ? {
      eyebrow: `MASSKA Online · ${edition.numeral}`,
      title: 'Scena online',
      lead: 'Teatry z całego świata pokazują swoje spektakle w sieci. Wybierz zespół, włącz napisy i oglądaj, gdziekolwiek jesteś.',
      when: 'Termin',
      provisional: 'termin do potwierdzenia',
      shows: 'Spektakle',
      countries: 'Kraje',
      countriesLabel: 'Kraje uczestniczące w festiwalu',
      mapTitle: 'Skąd przyjeżdżają zespoły',
      gridTitle: 'Zespoły i spektakle',
      note: 'Lista zespołów w przygotowaniu: poniższe wpisy to zaślepki.',
      filterLabel: 'Pokaż zespoły z regionu',
      all: 'Wszystkie',
      count: (n: number, total: number) => `Pokazano ${n} z ${total} spektakli`,
      placeholder: 'Zaślepka',
      available: 'Dostępny online',
      ctaTitle: 'Jesteś teatrem?',
      ctaText: 'Przyjmujemy zgłoszenia zespołów z Polski i z zagranicy. Wypełnij krótki formularz, a odezwiemy się do Ciebie.',
      ctaButton: 'Zgłoś swój teatr',
      regions: { europe: 'Europa', asia: 'Azja', americas: 'Ameryki', africa: 'Afryka', oceania: 'Oceania' },
    }
  : {
      eyebrow: `MASSKA Online · ${edition.numeral}`,
      title: 'Online stage',
      lead: 'Theatres from all over the world show their performances online. Pick an ensemble, turn on the subtitles and watch wherever you are.',
      when: 'Dates',
      provisional: 'dates to be confirmed',
      shows: 'Performances',
      countries: 'Countries',
      countriesLabel: 'Countries taking part in the festival',
      mapTitle: 'Where the ensembles come from',
      gridTitle: 'Ensembles and performances',
      note: 'The list of ensembles is being prepared: the entries below are placeholders.',
      filterLabel: 'Show ensembles from the region',
      all: 'All',
      count: (n: number, total: number) => `Showing ${n} of ${total} performances`,
      placeholder: 'Placeholder',
      available: 'Available online',
      ctaTitle: 'Are you a theatre?',
      ctaText: 'We accept applications from ensembles in Poland and abroad. Fill in a short form and we will get back to you.',
      ctaButton: 'Apply with your theatre',
      regions: { europe: 'Europe', asia: 'Asia', americas: 'The Americas', africa: 'Africa', oceania: 'Oceania' },
    };

const entries = await getCollection('theatres', ({ id }) => id.startsWith(`${lang}/`));
entries.sort(
  (a, b) => a.data.country.localeCompare(b.data.country, lang) || a.data.name.localeCompare(b.data.name, lang),
);

const regionOrder = ['europe', 'asia', 'americas', 'africa', 'oceania'] as const;
const regions = regionOrder
  .map((key) => ({ key, count: entries.filter((e) => e.data.region === key).length }))
  .filter((r) => r.count > 0);

// One flag per country, in the order of the list
const countries = [...new Map(entries.map((e) => [e.data.countryCode, e.data.country])).entries()];
const hasPlaceholders = entries.some((e) => e.data.placeholder);

const applyUrl = 'https://docs.google.com/forms/d/1-cCnZtjLfHMI9uyEodcN6xm2t2ZBQPrVYIwB4eLu0yE/viewform';

function slugOf(entry: (typeof entries)[number]) {
  return entry.slug.split('/').pop();
}

const mapPins = entries.map((entry) => ({
  id: entry.data.id,
  name: entry.data.name,
  city: entry.data.city.split(',')[0],
  country: entry.data.country,
  countryCode: entry.data.countryCode,
  lat: entry.data.lat,
  lon: entry.data.lon,
}));
function imageOf(entry: (typeof entries)[number]) {
  const src = entry.data.gallery[0]?.src;
  return src ? `..${src}` : '../assets/img/teatr/placeholder-1.webp';
}
---

<section class="stage-hero" aria-labelledby="stage-title">
    <div class="stage-hero__inner">
        <div class="stage-plate">
            <p class="stage-plate__eyebrow">{t.eyebrow}</p>
            <h1 id="stage-title">{t.title}</h1>
        </div>
        <div class="stage-hero__text">
            <p class="stage-hero__lead">{t.lead}</p>

            <dl class="stage-facts">
                <div>
                    <dt>{t.when}</dt>
                    <dd>
                        <time datetime={edition.start.slice(0, 10)}>{edition.dateLabel[lang]}</time>
                        {!edition.datesConfirmed && <span class="stage-facts__detail">{t.provisional}</span>}
                    </dd>
                </div>
                <div>
                    <dt>{t.shows}</dt>
                    <dd>{entries.length}</dd>
                </div>
                <div>
                    <dt>{t.countries}</dt>
                    <dd>{countries.length}</dd>
                </div>
            </dl>
        </div>
    </div>
</section>

<section class="page-section" id="spektakle" aria-labelledby="stage-grid-title" data-stage>
    <div class="section-inner">
        <h2 id="stage-grid-title">{t.gridTitle}</h2>

        {hasPlaceholders && <div class="announcement"><p>{t.note}</p></div>}

        <div class="stage-filter" role="group" aria-label={t.filterLabel} hidden data-stage-filter>
            <button type="button" aria-pressed="true" data-region="all">{t.all} ({entries.length})</button>
            {regions.map((r) => (
                <button type="button" aria-pressed="false" data-region={r.key}>{t.regions[r.key]} ({r.count})</button>
            ))}
        </div>
        <p class="stage-count" aria-live="polite" hidden data-stage-count></p>

        <ul class="stage-grid" role="list">
            {entries.map((entry) => (
                <li class="stage-card" data-region={entry.data.region}>
                    <figure class="stage-card__media">
                        <img src={imageOf(entry)} alt="" width="1000" height="667" loading="lazy" decoding="async" />
                        {entry.data.placeholder && <span class="stage-card__tag">{t.placeholder}</span>}
                    </figure>
                    <div class="stage-card__body">
                        <p class="stage-card__where">
                            <span class={`fi fi-${entry.data.countryCode}`} aria-hidden="true"></span>
                            {entry.data.country}
                        </p>
                        <h3 class="stage-card__title">
                            <a href={`${slugOf(entry)}.html`}>{entry.data.showTitle}</a>
                        </h3>
                        <p class="stage-card__name">{entry.data.name}</p>
                        <ul class="stage-card__chips" role="list">
                            <li>{entry.data.genre}</li>
                            <li>{entry.data.duration}</li>
                            <li>{isPl ? 'Napisy' : 'Subtitles'}: {entry.data.subtitles}</li>
                        </ul>
                        {entry.data.availability && (
                            <p class="stage-card__when">{t.available}: {entry.data.availability}</p>
                        )}
                    </div>
                </li>
            ))}
        </ul>
    </div>
</section>

<section class="page-section alt" aria-labelledby="stage-map-title">
    <div class="section-inner">
        <h2 id="stage-map-title">{t.mapTitle}</h2>
        <div class="stage-geo">
            <WorldMap lang={lang} pins={mapPins} />
            <ul class="flag-wall" role="list" aria-label={t.countriesLabel}>
                {countries.map(([code, name]) => (
                    <li>
                        <span class={`fi fi-${code}`} aria-hidden="true"></span>
                        <span>{name}</span>
                    </li>
                ))}
            </ul>
        </div>
    </div>
</section>

<section class="page-section" data-tone="dark" aria-labelledby="stage-cta-title">
    <div class="section-inner section-narrow stage-cta">
        <h2 id="stage-cta-title">{t.ctaTitle}</h2>
        <p>{t.ctaText}</p>
        <a class="button primary" href={applyUrl} target="_blank" rel="noopener noreferrer">{t.ctaButton}</a>
    </div>
</section>

<script define:vars={{ countTemplates: { pl: ['Pokazano ', ' z ', ' spektakli'], en: ['Showing ', ' of ', ' performances'] } }}>
    // Region filter: without JS the buttons stay hidden and every performance is listed
    (function () {
        const root = document.querySelector('[data-stage]');
        if (!root) return;
        const group = root.querySelector('[data-stage-filter]');
        const status = root.querySelector('[data-stage-count]');
        const cards = Array.from(root.querySelectorAll('.stage-card'));
        if (!group || !status) return;
        const parts = (document.documentElement.lang || 'pl').startsWith('pl') ? countTemplates.pl : countTemplates.en;

        function apply(region) {
            let shown = 0;
            cards.forEach((card) => {
                const match = region === 'all' || card.dataset.region === region;
                card.hidden = !match;
                if (match) shown += 1;
            });
            group.querySelectorAll('button').forEach((button) => {
                button.setAttribute('aria-pressed', String(button.dataset.region === region));
            });
            status.textContent = parts[0] + shown + parts[1] + cards.length + parts[2];
            status.hidden = region === 'all';
        }

        group.addEventListener('click', (event) => {
            const button = event.target.closest('button[data-region]');
            if (button) apply(button.dataset.region);
        });
        group.hidden = false;
    })();
</script>

<style>
    /* ---- Hero: a mauve title plate like the poster's, and a wall of the countries' flags ---- */
    .stage-hero {
        padding: clamp(1rem, 2.5vw, 1.75rem) var(--gutter);
        background: var(--color-bg);
    }

    /* A slim band: the title plate and, beside it, the line of text and the facts */
    .stage-hero__inner {
        display: grid;
        gap: var(--spacing-md) clamp(1.5rem, 4vw, 3rem);
        align-items: center;
        max-width: var(--max-width);
        margin: 0 auto;
    }

    @media (min-width: 900px) {
        .stage-hero__inner {
            grid-template-columns: auto minmax(0, 1fr);
        }
    }

    .stage-hero__text {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-sm);
    }

    .stage-plate {
        padding: clamp(0.8rem, 2vw, 1.25rem) clamp(1rem, 3vw, 1.75rem);
        border-radius: var(--radius-md);
        background: var(--color-mauve);
        color: var(--color-on-mauve);
    }

    .stage-plate__eyebrow {
        margin: 0 0 0.2rem;
        font-family: var(--font-family-headers);
        font-size: clamp(0.8rem, 2vw, 1rem);
        font-weight: 600;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: inherit;
    }

    .stage-plate h1 {
        margin: 0;
        font-size: clamp(2.4rem, 6vw, 4rem);
        font-weight: 700;
        line-height: 0.95;
        letter-spacing: 0.01em;
        text-transform: uppercase;
        color: inherit;
    }

    .stage-hero__lead {
        max-width: 42rem;
        margin: 0;
    }

    .stage-facts {
        display: flex;
        flex-wrap: wrap;
        gap: var(--spacing-xs) var(--spacing-lg);
        margin: 0;
    }

    .stage-facts dt {
        font-size: 0.75rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--color-muted);
    }

    .stage-facts dd {
        display: grid;
        margin: 0.15rem 0 0;
        font-family: var(--font-family-headers);
        font-size: 1.35rem;
        font-weight: 600;
        color: var(--color-text);
    }

    .stage-facts__detail {
        font-family: var(--font-family-base);
        font-size: 0.8rem;
        font-weight: var(--font-weight-regular);
        color: var(--color-blue-strong);
    }

    /* ---- Map and countries side by side ---- */
    .stage-geo {
        display: grid;
        gap: var(--spacing-lg);
        align-items: start;
    }

    @media (min-width: 900px) {
        .stage-geo {
            grid-template-columns: minmax(0, 860px) 15rem;
            justify-content: start;
        }
    }

    .flag-wall {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr));
        gap: 0.5rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    @media (min-width: 900px) {
        .flag-wall {
            grid-template-columns: 1fr;
        }
    }

    .flag-wall li {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        padding: 0.45rem 0.7rem;
        border: 2px solid var(--color-text);
        border-radius: var(--radius-sm);
        background: var(--color-bg);
        font-family: var(--font-family-headers);
        font-size: 0.95rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--color-text);
    }

    .flag-wall .fi {
        flex: none;
        font-size: 1.6rem;
    }

    @media (max-width: 899px) {
        .stage-facts {
            display: grid;
            grid-template-columns: 1fr 1fr;
        }

        .stage-facts > div:first-child {
            grid-column: 1 / -1;
        }
    }

    /* Phones: only the dates; the counts are already on the filter buttons */
    @media (max-width: 599px) {
        .stage-facts > div:not(:first-child) {
            display: none;
        }
    }

    /* The performances are the point of the page: they start right under the band */
    #spektakle.page-section {
        padding-top: clamp(1.25rem, 3vw, 2rem);
    }

    #spektakle h2 {
        font-size: clamp(1.6rem, 3vw, 2.2rem);
    }

    /* ---- Region filter ---- */
    .stage-filter {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin: var(--spacing-md) 0 var(--spacing-sm);
    }

    .stage-filter[hidden],
    .stage-count[hidden] {
        display: none;
    }

    /* Phones: one swipeable row instead of three rows of buttons */
    @media (max-width: 599px) {
        .stage-filter {
            flex-wrap: nowrap;
            margin-inline: calc(var(--gutter) * -1);
            padding: 0.25rem var(--gutter) 0.5rem;
            overflow-x: auto;
            scrollbar-width: none;
        }

        .stage-filter button {
            flex: none;
            white-space: nowrap;
        }
    }

    .stage-filter button {
        min-height: 2.5rem;
        padding: 0.4rem 1rem;
        border: 2px solid var(--btn-line);
        border-radius: var(--radius-ui);
        background: transparent;
        color: var(--btn-line);
        font-family: var(--font-family-headers);
        font-size: 0.95rem;
        font-weight: 600;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        cursor: pointer;
        transition: background-color var(--transition-base), color var(--transition-base);
    }

    .stage-filter button:hover,
    .stage-filter button:focus-visible,
    .stage-filter button[aria-pressed='true'] {
        border-color: var(--btn-primary-hover-line);
        background: var(--btn-hover);
        color: var(--btn-hover-fg);
    }

    .stage-filter button[aria-pressed='true'] {
        box-shadow: 3px 3px 0 var(--btn-shadow);
    }

    .stage-count {
        margin: 0 0 var(--spacing-sm);
        font-size: 0.9rem;
    }

    /* ---- Performance cards ---- */
    .stage-grid {
        display: grid;
        gap: var(--spacing-lg);
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
        margin: var(--spacing-md) 0 0;
        padding: 0;
        list-style: none;
    }

    .stage-card {
        position: relative;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-md);
        background: var(--color-surface);
        transition: box-shadow 0.3s ease, border-color 0.3s ease;
    }

    .stage-card[hidden] {
        display: none;
    }

    .stage-card:focus-within {
        outline: 3px solid var(--color-accent);
        outline-offset: 3px;
    }

    @media (hover: hover) {
        .stage-card:hover {
            border-color: var(--color-accent);
            box-shadow: var(--shadow-lg);
        }
    }

    .stage-card__media {
        position: relative;
        margin: 0;
        aspect-ratio: 3 / 2;
        overflow: hidden;
        background: var(--color-blue-soft);
    }

    .stage-card__media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    @media (hover: hover) {
        .stage-card:hover .stage-card__media img {
            transform: scale(1.05);
        }
    }

    .stage-card__tag {
        position: absolute;
        top: 0.6rem;
        left: 0.6rem;
        padding: 0.2rem 0.6rem;
        border-radius: var(--radius-ui);
        background: var(--color-peach);
        color: var(--color-text);
        font-size: 0.75rem;
        font-weight: var(--font-weight-medium);
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    .stage-card__body {
        display: flex;
        flex: 1;
        flex-direction: column;
        gap: 0.4rem;
        padding: var(--spacing-md);
    }

    .stage-card__where {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0;
        font-family: var(--font-family-headers);
        font-size: 0.9rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--color-blue-strong);
    }

    .stage-card__title {
        margin: 0;
        font-size: 1.35rem;
    }

    .stage-card__title a {
        color: var(--color-text);
        text-decoration: none;
    }

    /* The whole card is the link */
    .stage-card__title a::after {
        content: '';
        position: absolute;
        inset: 0;
    }

    .stage-card__title a:focus-visible {
        outline: none;
    }

    .stage-card__name {
        margin: 0;
        font-weight: var(--font-weight-medium);
        color: var(--color-text);
    }

    .stage-card__chips {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
        margin: 0.25rem 0 0;
        padding: 0;
        list-style: none;
    }

    .stage-card__chips li {
        padding: 0.2rem 0.6rem;
        border-radius: var(--radius-ui);
        background: var(--color-blue-soft);
        font-size: 0.8rem;
        color: var(--color-text);
    }

    .stage-card__when {
        margin: auto 0 0;
        padding-top: 0.5rem;
        font-size: 0.85rem;
    }

    /* ---- Call to action ---- */
    .stage-cta {
        display: grid;
        justify-items: start;
        gap: var(--spacing-sm);
    }

    .stage-cta p {
        max-width: 36rem;
        margin: 0 0 var(--spacing-sm);
    }
</style>
