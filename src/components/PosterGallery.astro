---
import { edition, posterArchive, type Lang } from '../data/edition';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const isPl = lang === 'pl';
---

<section class="page-section timeline-section" aria-labelledby="timeline-title" data-tone="dark">
    <div class="section-inner timeline-head">
        <div>
            <p class="timeline-eyebrow">{edition.firstYear} – {edition.year}</p>
            <h2 id="timeline-title">{isPl ? "25 lat Masski" : "25 years of Masska"}</h2>
            <p class="timeline-intro">
                {isPl
                    ? "Plakaty kolejnych edycji, od jubileuszowej XXV wstecz. Kliknij plakat, by go powiększyć."
                    : "Posters of each edition, from the XXV anniversary backwards. Click a poster to enlarge it."}
            </p>
            <p class="timeline-hint">
                {isPl ? "Przesuń w bok, by zobaczyć starsze edycje →" : "Swipe to see older editions →"}
            </p>
        </div>
        <div class="timeline-controls">
            <button type="button" class="timeline-btn" data-timeline-prev aria-label={isPl ? "Nowsze edycje" : "Newer editions"}>&#8249;</button>
            <button type="button" class="timeline-btn" data-timeline-next aria-label={isPl ? "Starsze edycje" : "Older editions"}>&#8250;</button>
        </div>
    </div>

    <ol class="poster-timeline" role="list" data-timeline tabindex="0" aria-labelledby="timeline-title">
        {posterArchive.map((poster, index) => (
            <li class:list={["poster-item", { "is-current": poster.year === edition.year }]}>
                <p class="poster-item__marker">
                    <span class="poster-item__year">{poster.year}</span>
                    {poster.year === edition.year && (
                        <span class="poster-item__badge">{isPl ? "Jubileusz" : "Anniversary"}</span>
                    )}
                </p>
                {poster.src ? (
                    <a href={poster.src} class="poster-link">
                        <img
                            src={poster.src}
                            alt={isPl ? `Plakat ${poster.numeral} edycji MASSKA ${poster.year}` : `Poster of the ${poster.numeral} MASSKA edition, ${poster.year}`}
                            loading={index < 6 ? "eager" : "lazy"}
                            decoding="async"
                        />
                        <span class="poster-caption">{poster.numeral} · MASSKA {poster.year}</span>
                    </a>
                ) : (
                    <div class="poster-missing">
                        <span class="poster-missing__numeral" aria-hidden="true">{poster.numeral}</span>
                        <span class="poster-missing__text">{isPl ? "Plakat wkrótce w archiwum" : "Poster coming to the archive"}</span>
                        <span class="poster-caption">{poster.numeral} · MASSKA {poster.year}</span>
                    </div>
                )}
            </li>
        ))}
    </ol>
</section>

<!-- Native modal dialog: traps focus, closes on Escape and hides the page from assistive tech -->
<dialog id="poster-lightbox" class="lightbox-modal" aria-labelledby="lightbox-caption">
    <button type="button" class="lightbox-close" aria-label={isPl ? "Zamknij podgląd" : "Close preview"}>&times;</button>
    <button type="button" class="lightbox-nav lightbox-prev" aria-label={isPl ? "Poprzedni plakat" : "Previous poster"}>&#8249;</button>
    <div class="lightbox-content">
        <img id="lightbox-img" alt="" />
        <p id="lightbox-caption" class="lightbox-caption" aria-live="polite"></p>
    </div>
    <button type="button" class="lightbox-nav lightbox-next" aria-label={isPl ? "Następny plakat" : "Next poster"}>&#8250;</button>
</dialog>

<script>
    // Timeline arrows scroll by roughly two posters and disable themselves at either end
    const track = document.querySelector<HTMLElement>('[data-timeline]');
    const prevTimeline = document.querySelector<HTMLButtonElement>('[data-timeline-prev]');
    const nextTimeline = document.querySelector<HTMLButtonElement>('[data-timeline-next]');

    function updateTimelineButtons() {
        if (!track || !prevTimeline || !nextTimeline) return;
        prevTimeline.disabled = track.scrollLeft <= 4;
        nextTimeline.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
    }

    function scrollTimeline(direction: number) {
        const item = track?.querySelector<HTMLElement>('.poster-item');
        if (!track || !item) return;
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        track.scrollBy({ left: direction * item.offsetWidth * 2, behavior: reduceMotion ? 'auto' : 'smooth' });
    }

    prevTimeline?.addEventListener('click', () => scrollTimeline(-1));
    nextTimeline?.addEventListener('click', () => scrollTimeline(1));
    track?.addEventListener('scroll', updateTimelineButtons, { passive: true });
    window.addEventListener('resize', updateTimelineButtons);
    updateTimelineButtons();

    const links = document.querySelectorAll<HTMLAnchorElement>('.poster-link');
    const modal = document.getElementById('poster-lightbox') as HTMLDialogElement | null;
    const img = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const caption = document.getElementById('lightbox-caption');
    const closeBtn = modal?.querySelector('.lightbox-close');
    const prevBtn = modal?.querySelector('.lightbox-prev');
    const nextBtn = modal?.querySelector('.lightbox-next');

    let currentIndex = 0;
    let opener: HTMLElement | null = null;

    function show(index: number) {
        if (!img || !caption) return;
        currentIndex = (index + links.length) % links.length;
        const link = links[currentIndex];
        img.src = link.getAttribute('href') ?? '';
        img.alt = link.querySelector('img')?.alt ?? '';
        caption.textContent = link.querySelector('.poster-caption')?.textContent ?? '';
    }

    function openLightbox(index: number, trigger: HTMLElement) {
        if (!modal) return;
        opener = trigger;
        show(index);
        modal.showModal();
        document.body.style.overflow = 'hidden';
    }

    // Restores page scroll and focus; safe to run more than once
    function afterClose() {
        document.body.style.overflow = '';
        if (opener && document.activeElement !== opener) opener.focus();
    }

    function closeLightbox() {
        modal?.close();
        afterClose();
    }

    // Escape (cancel) and any other way the dialog closes
    modal?.addEventListener('cancel', afterClose);
    modal?.addEventListener('close', afterClose);

    links.forEach((link, index) => {
        link.addEventListener('click', (e) => {
            e.preventDefault();
            openLightbox(index, link);
        });
    });

    closeBtn?.addEventListener('click', closeLightbox);

    // Clicks on the dimmed area around the poster close the dialog
    modal?.addEventListener('click', (e) => {
        if (e.target === modal || e.target === modal.querySelector('.lightbox-content')) {
            closeLightbox();
        }
    });

    prevBtn?.addEventListener('click', () => show(currentIndex - 1));
    nextBtn?.addEventListener('click', () => show(currentIndex + 1));

    modal?.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') show(currentIndex - 1);
        if (e.key === 'ArrowRight') show(currentIndex + 1);
    });

    // Touch Swipe Navigation for Mobile
    let touchStartX = 0;
    let touchEndX = 0;
    const swipeThreshold = 50; // minimum X diff to trigger swipe

    modal?.addEventListener('touchstart', (e: any) => {
        if (e.touches && e.touches.length > 0) {
            touchStartX = e.touches[0].clientX;
        }
    }, { passive: true });

    modal?.addEventListener('touchend', (e: any) => {
        if (e.changedTouches && e.changedTouches.length > 0) {
            touchEndX = e.changedTouches[0].clientX;
            const diff = touchEndX - touchStartX;
            if (Math.abs(diff) > swipeThreshold) {
                show(currentIndex + (diff > 0 ? -1 : 1)); // swipe right -> previous
            }
        }
    }, { passive: true });
</script>

<style>
    .timeline-section {
        padding-inline: 0;
        background:
            linear-gradient(180deg, var(--color-blue-soft) 0%, transparent 70%),
            var(--color-bg);
    }

    .timeline-head {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        justify-content: space-between;
        gap: var(--spacing-md);
        padding-inline: var(--gutter);
    }

    .timeline-eyebrow {
        margin: 0 0 0.25rem;
        font-size: 0.85rem;
        font-weight: var(--font-weight-medium);
        letter-spacing: 0.12em;
        color: var(--color-blue-strong);
    }

    .timeline-intro {
        max-width: 36rem;
        margin: 0;
    }

    .timeline-controls {
        display: flex;
        gap: 0.5rem;
    }

    .timeline-btn {
        width: 2.75rem;
        height: 2.75rem;
        border-radius: var(--radius-ui);
        border: 2px solid var(--color-text);
        background: transparent;
        color: var(--color-text);
        font-size: 1.6rem;
        line-height: 1;
        cursor: pointer;
        transition: background-color var(--transition-base), border-color var(--transition-base);
    }

    .timeline-btn:hover:not(:disabled),
    .timeline-btn:focus-visible {
        background: var(--btn-hover);
        color: var(--btn-hover-fg);
    }

    .timeline-btn:disabled {
        opacity: 0.35;
        cursor: default;
    }

    .poster-timeline {
        --item-width: clamp(170px, 19vw, 230px);
        position: relative;
        display: flex;
        gap: 1.5rem;
        margin: var(--spacing-lg) 0 0;
        padding: 0 0 1.5rem;
        /* Line the first poster up with the section heading, then let the row run full width */
        padding-inline: max(var(--gutter), calc((100% - var(--max-width)) / 2));
        scroll-padding-inline: max(var(--gutter), calc((100% - var(--max-width)) / 2));
        list-style: none;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        /* Finger swipes scroll the row sideways and still let the page scroll vertically;
           reaching either end does not pull the browser back/forward */
        touch-action: pan-x pan-y;
        overscroll-behavior-x: contain;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: thin;
        scrollbar-color: var(--color-blue-strong) transparent;
    }

    .poster-timeline:focus-visible {
        outline: 3px solid var(--color-accent);
        outline-offset: -3px;
    }

    .poster-item {
        position: relative;
        flex: 0 0 var(--item-width);
        margin: 0;
        scroll-snap-align: start;
    }

    /* Timeline rail: each item draws its own segment so the line spans the whole row */
    .poster-item::before {
        content: '';
        position: absolute;
        top: 1.05rem;
        left: 0;
        right: -1.5rem;
        height: 2px;
        background: var(--color-blue-strong);
        opacity: 0.35;
    }

    .poster-item:last-child::before {
        right: 50%;
    }

    .poster-item__marker {
        position: relative;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        height: 2.1rem;
        margin: 0 0 0.75rem;
    }

    .poster-item__year {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding-right: 0.5rem;
        background: transparent;
        font-family: var(--font-family-headers);
        font-weight: 700;
        font-size: 1.15rem;
        color: var(--color-text);
    }

    .poster-item__year::before {
        content: '';
        width: 0.8rem;
        height: 0.8rem;
        border-radius: 50%;
        background: var(--color-bg);
        border: 2px solid var(--color-blue-strong);
    }

    .poster-item.is-current .poster-item__year::before {
        width: 1rem;
        height: 1rem;
        background: var(--color-mauve);
        border-color: var(--color-mauve);
        box-shadow: 0 0 0 4px var(--color-blue);
    }

    .poster-item__badge {
        padding: 0.15rem 0.6rem;
        border-radius: var(--radius-ui);
        background: var(--color-mauve);
        color: var(--color-on-mauve);
        font-size: 0.75rem;
        font-weight: var(--font-weight-medium);
        letter-spacing: 0.04em;
    }

    .poster-link,
    .poster-missing {
        display: block;
        overflow: hidden;
        border-radius: var(--radius-sm);
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        color: inherit;
        text-decoration: none;
        transition: transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94), box-shadow 0.3s ease, border-color 0.3s ease;
    }

    .poster-link:focus-visible {
        border-color: var(--color-blue-strong);
        text-decoration: none;
    }

    @media (hover: hover) {
        .poster-link:hover {
            transform: translateY(-6px);
            box-shadow: var(--shadow-lg);
            border-color: var(--color-blue-strong);
            text-decoration: none;
        }
    }

    .poster-item.is-current .poster-link {
        border: 2px solid var(--color-mauve);
    }

    .poster-link img {
        width: 100%;
        height: auto;
        aspect-ratio: 1 / 1.4;
        object-fit: cover;
        display: block;
    }

    .poster-missing {
        display: grid;
        grid-template-rows: 1fr auto;
        border-style: dashed;
    }

    .poster-missing__numeral,
    .poster-missing__text {
        grid-row: 1;
        grid-column: 1;
    }

    .poster-missing__numeral {
        display: grid;
        place-items: center;
        aspect-ratio: 1 / 1.4;
        font-family: var(--font-family-headers);
        font-size: 3.5rem;
        font-weight: 700;
        color: var(--color-blue-strong);
    }

    .poster-missing__text {
        align-self: end;
        padding: 0.75rem;
        font-size: 0.8rem;
        text-align: center;
        color: var(--color-muted);
    }

    .poster-caption {
        display: block;
        padding: 0.65rem 0.75rem;
        text-align: center;
        font-family: var(--font-family-headers);
        font-weight: 600;
        font-size: 0.95rem;
        letter-spacing: 0.02em;
        color: var(--color-text);
        background: var(--color-surface);
        border-top: 1px solid var(--color-border);
    }

    /* Lightbox Modal Styles */
    /* Full-screen <dialog>; the UA hides it while closed */
    .lightbox-modal {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        max-width: none;
        max-height: none;
        margin: 0;
        padding: 0;
        border: 0;
        background: rgba(10, 11, 15, 0.92);
        color: #fff;
        touch-action: pan-y; /* horizontal swipes go to the poster navigation */
    }

    .lightbox-modal[open] {
        display: flex;
        justify-content: center;
        align-items: center;
        animation: lightbox-in 0.25s ease;
    }

    .lightbox-modal::backdrop {
        background: transparent;
    }

    @keyframes lightbox-in {
        from {
            opacity: 0;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .lightbox-modal[open] {
            animation: none;
        }
    }

    .lightbox-content {
        position: relative;
        max-width: 85%;
        max-height: 85vh;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .lightbox-content img {
        max-width: 100%;
        max-height: 70vh;
        object-fit: contain;
        border-radius: 8px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
        transition: opacity 0.2s ease, transform 0.2s ease;
        opacity: 1;
        transform: scale(1);
    }

    .lightbox-caption {
        color: #fff;
        margin-top: 1.5rem;
        font-size: 1.25rem;
        font-weight: 500;
        letter-spacing: 0.5px;
        text-align: center;
        transition: opacity 0.2s ease;
        opacity: 1;
    }

    .lightbox-close {
        position: absolute;
        top: 2rem;
        right: 2rem;
        background: rgba(31, 29, 27, 0.7);
        border: 2px solid #f5f2ee;
        color: #f5f2ee;
        font-size: 2.2rem;
        line-height: 1;
        cursor: pointer;
        transition: background-color 0.2s, color 0.2s, border-color 0.2s;
        z-index: 10100;
        width: 50px;
        height: 50px;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: var(--radius-ui);
    }

    .lightbox-close:hover,
    .lightbox-close:focus-visible,
    .lightbox-nav:hover,
    .lightbox-nav:focus-visible {
        border-color: var(--btn-hover);
        background: var(--btn-hover);
        color: var(--btn-hover-fg);
    }

    .lightbox-nav {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background: rgba(31, 29, 27, 0.7);
        border: 2px solid #f5f2ee;
        color: #f5f2ee;
        font-size: 2.5rem;
        width: 60px;
        height: 60px;
        border-radius: var(--radius-ui);
        cursor: pointer;
        display: flex;
        justify-content: center;
        align-items: center;
        transition: background-color 0.2s, color 0.2s, border-color 0.2s;
        z-index: 10100;
    }

    .lightbox-prev {
        left: 2rem;
    }

    .lightbox-next {
        right: 2rem;
    }

    .timeline-hint {
        display: none;
        margin: var(--spacing-sm) 0 0;
        font-size: 0.85rem;
        color: var(--color-muted);
    }

    @media (max-width: 768px) {
        /* A carousel: one poster is centred, its neighbours peek in from both sides, and a swipe
           glides to the next one (the browser's own snapping, one poster per swipe) */
        .poster-timeline {
            --item-width: min(66vw, 250px);
            --centre: calc((100% - var(--item-width)) / 2);
            gap: 1rem;
            padding-inline: var(--centre);
            scroll-padding-inline: var(--centre);
        }

        .poster-item {
            scroll-snap-align: center;
            scroll-snap-stop: always;
        }

        .timeline-hint {
            display: block;
        }

        .lightbox-content {
            max-width: 92%;
        }

        .lightbox-content img {
            max-height: 76dvh;
        }

        .poster-item::before {
            right: -1rem;
        }

        /* Swipe replaces the arrows on touch-sized screens */
        .timeline-controls {
            display: none;
        }

        .lightbox-nav {
            width: 45px;
            height: 45px;
            font-size: 1.8rem;
        }
        
        .lightbox-prev {
            left: 1rem;
        }
        
        .lightbox-next {
            right: 1rem;
        }
        
        .lightbox-close {
            top: 1rem;
            right: 1rem;
            font-size: 2.2rem;
        }
    }
</style>
